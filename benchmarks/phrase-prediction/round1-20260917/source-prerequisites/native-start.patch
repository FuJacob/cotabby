+    assert(sorted(vocabulary.matchingTokens(" ")) == std::vector<int32_t>({6, 7}));
+    assert(sorted(vocabulary.matchingTokens("\n")) == std::vector<int32_t>({10, 11}));
+    assert(sorted(vocabulary.matchingTokens("é")) == std::vector<int32_t>({12, 13}));
