# Public commands live here; ReleasePipeline owns the shared release transaction.
# Each invocation gets one pipeline instance, which keeps its commit and artifact
# provenance together and serializes access to the repo's single DerivedData tree.
require_relative "lib/release_pipeline"

# Build failures belong in the local/CI log; don't send their text to an issue search.
ENV["FASTLANE_HIDE_GITHUB_ISSUES"] = "1"

default_platform(:mac)
skip_docs

platform :mac do
  desc "Build, verify signing compatibility, and launch Cotabby locally"
  lane :dev do |options|
    pipeline = Cotabby::ReleasePipeline.new
    pipeline.exclusive do
      pipeline.dev(configuration: options.fetch(:configuration, "Debug"), logs: options[:logs] == true)
    end
  end

  desc "Run lint, project consistency, pipeline tests, Python tests, and macOS unit tests"
  lane :verify do |options|
    pipeline = Cotabby::ReleasePipeline.new
    pipeline.exclusive { pipeline.verify(signed: options.fetch(:signed, true) != false) }
  end

  desc "Create a signed, notarized DMG and matching source artifacts without publishing"
  lane :package do |options|
    pipeline = Cotabby::ReleasePipeline.new
    pipeline.exclusive { pipeline.package(suffix: options[:suffix]) }
  end

  desc "Validate, package, and publish a GitHub pre-release (suffix:beta.1 or rc.1)"
  lane :prerelease do |options|
    UI.user_error!("Supply suffix:beta.1, alpha.1, or rc.1") if options[:suffix].to_s.empty?
    pipeline = Cotabby::ReleasePipeline.new
    pipeline.exclusive { pipeline.publish(suffix: options[:suffix]) }
  end

  desc "Validate, package, and publish a stable GitHub release as Latest"
  lane :release do
    pipeline = Cotabby::ReleasePipeline.new
    pipeline.exclusive { pipeline.publish }
  end

  desc "Check build tools, Developer ID signing, notarization, and GitHub access"
  lane :doctor do
    Cotabby::ReleasePipeline.new.doctor
  end
end
