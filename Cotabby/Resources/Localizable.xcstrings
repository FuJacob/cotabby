    "Whether this Mac can run Apple Intelligence.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما إذا كان بإمكان جهاز Mac هذا تشغيل Apple Intelligence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob dieser Mac Apple Intelligence ausführen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si este Mac puede ejecutar Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si ce Mac peut exécuter Apple Intelligence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac Apple Intelligence चला सकता है या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Mac ini dapat menjalankan Apple Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se questo Mac può eseguire Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでApple Intelligenceを実行できるかどうか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Apple Intelligence를 실행할 수 있는지 여부."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este Mac pode executar o Apple Intelligence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может ли этот Mac запускать Apple Intelligence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in Apple Intelligence'ı çalıştırıp çalıştıramayacağı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 是否可以运行 Apple Intelligence。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 是否可執行 Apple Intelligence。"
          }
        }
      }
    },
    "Whether this Mac can run Apple Intelligence. Requires a supported Apple Silicon Mac with Apple Intelligence turned on in System Settings.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+AppleIntelligence.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما إذا كان بإمكان جهاز Mac هذا تشغيل Apple Intelligence. يتطلب جهاز Mac مدعومًا مزودًا بـ Apple Silicon مع تفعيل Apple Intelligence في إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob dieser Mac Apple Intelligence ausführen kann. Erfordert einen unterstützten Apple-Silicon-Mac mit aktivierter Apple Intelligence in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si este Mac puede ejecutar Apple Intelligence. Requiere un Mac Apple Silicon compatible con Apple Intelligence activado en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si ce Mac peut exécuter Apple Intelligence. Nécessite un Mac Apple Silicon pris en charge avec Apple Intelligence activé dans Réglages Système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac Apple Intelligence चला सकता है या नहीं। इसके लिए समर्थित Apple Silicon Mac और सिस्टम सेटिंग्ज़ में चालू Apple Intelligence आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Mac ini dapat menjalankan Apple Intelligence. Memerlukan Mac Apple Silicon yang didukung dengan Apple Intelligence dinyalakan di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se questo Mac può eseguire Apple Intelligence. Richiede un Mac Apple Silicon supportato con Apple Intelligence attivata nelle Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでApple Intelligenceを実行できるかどうか。対応するApple Silicon Macと、システム設定でオンにしたApple Intelligenceが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Apple Intelligence를 실행할 수 있는지 여부입니다. Apple Intelligence가 시스템 설정에서 켜져 있고 지원되는 Apple Silicon Mac이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este Mac pode executar o Apple Intelligence. Requer um Mac Apple Silicon compatível com o Apple Intelligence ativado nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может ли этот Mac запускать Apple Intelligence. Требуется поддерживаемый Mac с Apple Silicon и включённой Apple Intelligence в системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in Apple Intelligence'ı çalıştırıp çalıştıramayacağını gösterir. Desteklenen bir Apple Silicon Mac ve Sistem Ayarları'nda etkinleştirilmiş Apple Intelligence gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 是否可以运行 Apple Intelligence。需要受支持的 Apple Silicon Mac，并在系统设置中开启 Apple Intelligence。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 是否可執行 Apple Intelligence。需要支援的 Apple Silicon Mac，並在「系統設定」中開啟 Apple Intelligence。"
          }
        }
      }
    },
    "Which downloaded model file generates suggestions. Larger models are slower but write better.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+OpenSource.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف النموذج الذي تم تنزيله لتوليد الاقتراحات. النماذج الأكبر أبطأ لكنها تكتب بصورة أفضل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche heruntergeladene Modelldatei Vorschläge generiert. Größere Modelle sind langsamer, schreiben aber besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué archivo de modelo descargado genera las sugerencias. Los modelos grandes son más lentos, pero escriben mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel fichier de modèle téléchargé génère les suggestions. Les modèles plus grands sont plus lents, mais écrivent mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-सी डाउनलोड की गई मॉडल फ़ाइल सुझाव जनरेट करती है। बड़े मॉडल धीमे होते हैं, लेकिन बेहतर लिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File model yang diunduh untuk membuat saran. Model yang lebih besar lebih lambat, tetapi menghasilkan teks yang lebih baik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale file di modello scaricato genera i suggerimenti. I modelli più grandi sono più lenti ma scrivono meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補を生成するダウンロード済みモデルファイル。大きいモデルほど遅くなりますが、よりよい文章を生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안을 생성하는 다운로드된 모델 파일입니다. 큰 모델은 느리지만 더 잘 작성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual arquivo de modelo baixado gera sugestões. Modelos maiores são mais lentos, mas escrevem melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой загруженный файл модели создаёт подсказки. Большие модели работают медленнее, но пишут лучше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi indirilen model dosyasının öneri oluşturduğu. Daha büyük modeller daha yavaştır ama daha iyi yazar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成建议的下载模型文件。模型越大，速度越慢，但写作效果越好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生建議的下載模型檔案。較大型的模型速度較慢，但寫作品質較佳。"
          }
        }
      }
    },
