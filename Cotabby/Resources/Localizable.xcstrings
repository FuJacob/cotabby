    "Accept suggestions without leaving the keyboard.\nYou can change these anytime in Settings.": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeKeybindStepView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقبل الاقتراحات من دون مغادرة لوحة المفاتيح.\nيمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge übernehmen, ohne die Tastatur zu verlassen.\nDu kannst dies jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta sugerencias sin dejar el teclado.\nPuedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptez les suggestions sans quitter le clavier.\nVous pouvez modifier ces réglages à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड छोड़े बिना सुझाव स्वीकार करें।\nआप इन्हें सेटिंग्ज़ में कभी भी बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima saran tanpa meninggalkan keyboard.\nAnda dapat mengubahnya kapan saja di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta i suggerimenti senza lasciare la tastiera.\nPuoi modificarli in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードから手を離さず候補を挿入できます。\n設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 손을 떼지 않고 제안을 수락하세요.\n설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceite sugestões sem tirar as mãos do teclado.\nVocê pode alterar isso a qualquer momento em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимайте подсказки, не убирая руки с клавиатуры.\nИзменить это можно в любое время в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeden elinizi çekmeden önerileri kabul edin.\nBu ayarları istediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需离开键盘即可插入建议。\n你可以随时在设置中更改这些按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用離開鍵盤即可接受建議。\n你可以隨時在「設定」中變更這些項目。"
          }
        }
      }
    },
