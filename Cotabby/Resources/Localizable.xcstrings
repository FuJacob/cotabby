    "Start typing anywhere.\nPress %@ to accept a word, %@ for the full suggestion.": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الكتابة في أي مكان.\nاضغط %@ لقبول كلمة، و%@ لقبول الاقتراح بالكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne überall zu tippen.\nDrücke %@, um ein Wort zu übernehmen, %@ für den gesamten Vorschlag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Start typing anywhere.\nPress %1$@ to accept a word, %2$@ for the full suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escribir en cualquier lugar.\nPulsa %@ para aceptar una palabra y %@ para aceptar la sugerencia completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à saisir n’importe où.\nAppuyez sur %@ pour accepter un mot, %@ pour toute la suggestion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं भी टाइप करना शुरू करें।\nशब्द स्वीकार करने के लिए %@ दबाएँ, पूरे सुझाव के लिए %@।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai mengetik di mana saja.\nTekan %@ untuk menerima kata, %@ untuk seluruh saran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a digitare ovunque.\nPremi %@ per accettare una parola, %@ per l'intero suggerimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも入力を始めましょう。\n単語を挿入するには%@、候補全体を挿入するには%@を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 입력을 시작하세요.\n%@을(를) 누르면 단어를 수락하고, %@을(를) 누르면 전체 제안을 수락합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a digitar em qualquer lugar.\nPressione %@ para aceitar uma palavra e %@ para a sugestão inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните печатать где угодно.\nНажмите %@, чтобы принять слово, и %@, чтобы принять всю подсказку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerde yazmaya başlayın.\nBir kelimeyi kabul etmek için %@, önerinin tamamı için %@ tuşuna basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随处开始输入。\n按 %@ 插入下一个单词，按 %@ 插入整条建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方開始輸入。\n按 %@ 接受單字，按 %@ 接受完整建議。"
          }
        }
      }
    },
