    "Cotabby could not restart. Quit and reopen it to apply the selected language.": {
      "comment": "Error shown if relaunch helper cannot launch. The app remains running; language choice stays saved for a later restart. Give the user the manual recovery step.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت إعادة تشغيل Cotabby. أغلق Cotabby ثم افتحه مجددًا لتطبيق اللغة المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby konnte nicht neu gestartet werden. Beende die App und öffne sie erneut, um die ausgewählte Sprache anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar Cotabby. Cierra la app y vuelve a abrirla para aplicar el idioma seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby n’a pas pu redémarrer. Quittez puis rouvrez l’app pour appliquer la langue choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby को फिर से शुरू नहीं किया जा सका। चुनी गई भाषा लागू करने के लिए इसे बंद करके फिर खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby tidak dapat dimulai ulang. Tutup lalu buka kembali Cotabby untuk menerapkan bahasa yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby non è riuscito a riavviarsi. Chiudi e riapri l’app per applicare la lingua selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyを再起動できませんでした。選択した言語を適用するには、Cotabbyを終了して再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby를 재시동하지 못했습니다. 선택한 언어를 적용하려면 Cotabby를 종료한 뒤 다시 실행하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reiniciar o Cotabby. Feche o app e abra-o novamente para aplicar o idioma selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перезапустить Cotabby. Закройте Cotabby и откройте его снова, чтобы применить выбранный язык."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby yeniden başlatılamadı. Seçilen dili uygulamak için uygulamayı kapatıp yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby 无法重启。请退出并重新打开 Cotabby，以应用所选语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby 無法重新啟動。請結束並重新開啟 Cotabby，以套用所選語言。"
          }
        }
      }
    },
