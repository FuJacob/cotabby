    "Click the cat to pause suggestions, switch models, or open Settings.": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على القطة لإيقاف الاقتراحات مؤقتًا أو تبديل النماذج أو فتح الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Katze, um Vorschläge zu pausieren, Modelle zu wechseln oder die Einstellungen zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el gato para pausar las sugerencias, cambiar de modelo o abrir Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le chat pour mettre les suggestions en pause, changer de modèle ou ouvrir Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव रोकने, मॉडल बदलने या सेटिंग्ज़ खोलने के लिए बिल्ली पर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kucing untuk menjeda saran, mengganti model, atau membuka Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul gatto per mettere in pausa i suggerimenti, cambiare modello o aprire le Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫をクリックすると候補を一時停止したり、モデルを切り替えたり、設定を開いたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이를 클릭해 제안을 일시 중지하거나 모델을 전환하거나 설정을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no gato para pausar sugestões, trocar modelos ou abrir Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на кота, чтобы приостановить подсказки, сменить модели или открыть настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
