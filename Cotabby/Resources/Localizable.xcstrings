    "Lets Cotabby see which text field has focus and read its contents so it knows what to continue.": {
      "comment": "Used in: UI/Settings/Panes/PermissionsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لـ Cotabby بمعرفة حقل النص النشط وقراءة محتواه كي يعرف ما الذي سيكمله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby kann sehen, welches Textfeld fokussiert ist, und dessen Inhalt lesen, damit es weiß, wie es fortsetzen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Cotabby vea qué campo de texto tiene el foco y lea su contenido para saber cómo continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à Cotabby de voir quel champ de texte est actif et d’en lire le contenu pour savoir comment continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby को यह देखने दें कि किस टेक्स्ट फ़ील्ड पर फ़ोकस है और उसकी सामग्री पढ़ने दें, ताकि उसे पता चले कि क्या जारी रखना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Cotabby melihat bidang teks yang fokus dan membaca isinya agar tahu apa yang harus dilanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette a Cotabby di vedere quale campo di testo è attivo e leggerne il contenuto, così sa cosa continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyがフォーカス中のテキストフィールドを確認し、その内容を読み取って続きがわかるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby가 포커스된 텍스트 필드를 확인하고 내용을 읽어 무엇을 이어갈지 알 수 있도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Cotabby veja qual campo de texto está em foco e leia seu conteúdo para saber como continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить Cotabby видеть, какое текстовое поле в фокусе, и читать его содержимое, чтобы знать, что продолжить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby'nin odaktaki metin alanını belirlemesini ve devamını yazabilmek için içeriğini okumasını sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Cotabby 查看哪个文本输入框处于焦点并读取其内容，以便知道如何续写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Cotabby 查看哪個輸入欄位已聚焦並讀取其內容，以知道要接續的文字。"
          }
        }
      }
    },
    "Lets Cotabby see your keystrokes so it can detect when to suggest and which key you used to accept.": {
      "comment": "Used in: UI/Settings/Panes/PermissionsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لـ Cotabby برصد ضغطات المفاتيح كي يكتشف متى يعرض اقتراحًا وأي مفتاح استخدمته لقبوله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby kann deine Tastenanschläge sehen, um zu erkennen, wann es vorschlagen soll und welche Taste du zum Übernehmen verwendet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Cotabby vea tus pulsaciones para detectar cuándo debe sugerir y qué tecla usaste para aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à Cotabby de voir vos frappes pour détecter quand suggérer et quelle touche vous avez utilisée pour accepter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby को आपके कीस्ट्रोक देखने दें, ताकि वह सुझाव देने का समय और स्वीकार करने के लिए उपयोग की गई कुंजी पहचान सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Cotabby melihat penekanan tombol Anda agar dapat mendeteksi kapan harus memberi saran dan tombol yang digunakan untuk menerima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette a Cotabby di rilevare la digitazione, così può capire quando mostrare suggerimenti e quale tasto hai usato per accettarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyがキー入力を確認し、候補を表示するタイミングと挿入に使ったキーを検出できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby가 키 입력을 확인해 언제 제안할지, 어떤 키로 수락했는지 감지하도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Cotabby veja suas teclas para detectar quando sugerir e qual tecla você usou para aceitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить Cotabby видеть нажатия клавиш, чтобы определять, когда предлагать подсказку и какую клавишу вы использовали для принятия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby'nin ne zaman öneri sunacağını ve kabul etmek için hangi tuşu kullandığınızı algılayabilmesi için tuş vuruşlarınızı izlemesini sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Cotabby 查看你的按键，以便检测何时提供建议，以及你用哪个按键插入建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Cotabby 查看你的按鍵，以偵測何時提供建議，以及你用哪個按鍵接受建議。"
          }
        }
      }
    },
