    "Install LM Studio to load models from its library here.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+OpenSource.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت LM Studio لتحميل النماذج من مكتبته هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
