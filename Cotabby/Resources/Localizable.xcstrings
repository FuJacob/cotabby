    "Nothing here is saved or shared; it only exercises the on-device model.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء هنا محفوظ أو مشترك؛ فهذا يختبر النموذج على الجهاز فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wird nichts gespeichert oder geteilt; es dient nur dazu, das On-Device-Modell zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se guarda ni se comparte nada; solo se prueba el modelo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici n’est enregistré ni partagé ; cela sert uniquement à tester le modèle sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कुछ भी सेव या साझा नहीं किया जाता; यह केवल डिवाइस पर मॉडल को परखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang disimpan atau dibagikan di sini; ini hanya menguji model di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non viene salvato né condiviso nulla; serve solo a provare il modello sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは保存も共有もされません。デバイス上のモデルを試すだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되거나 공유되는 내용 없이 기기 내 모델만 테스트합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui é salvo ou compartilhado; isso apenas exercita o modelo no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не сохраняется и не передаётся; это только проверка модели на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada hiçbir şey kaydedilmez veya paylaşılmaz; yalnızca aygıt üzerindeki modeli çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处内容不会保存或共享；它只用于测试设备端模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的內容不會儲存或分享；只會測試裝置端模型。"
          }
        }
      }
    },
