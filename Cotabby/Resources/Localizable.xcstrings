    "Whether Cotabby can reach the server and list its models.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما إذا كان بإمكان Cotabby الوصول إلى الخادم وسرد نماذجه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob Cotabby den Server erreichen und seine Modelle auflisten kann."
          }
        },
        "es": {
