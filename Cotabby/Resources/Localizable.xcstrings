    "Help suggestions understand surrounding text using screenshots of the focused window.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift, UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد الاقتراحات على فهم النص المحيط باستخدام لقطات شاشة للنافذة النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Cotabby mithilfe von Screenshots des fokussierten Fensters, den umgebenden Text besser zu verstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a las sugerencias a entender el texto circundante usando capturas de la ventana enfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettre aux suggestions de mieux comprendre le texte environnant grâce à des captures d’écran de la fenêtre active."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस की गई विंडो के स्क्रीनशॉट का उपयोग करके सुझावों को आसपास का टेक्स्ट समझने में मदद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu saran memahami teks di sekitar dengan mengambil tangkapan layar jendela aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta i suggerimenti a comprendere il testo circostante usando screenshot della finestra attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のウィンドウのスクリーンショットを使って、候補が周囲のテキストを理解できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 윈도우의 스크린샷을 사용해 제안이 주변 텍스트를 이해하도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude as sugestões a entender o texto ao redor usando capturas de tela da janela em foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите подсказкам понимать окружающий текст с помощью снимков окна в фокусе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaktaki pencerenin ekran görüntülerini kullanarak önerilerin çevredeki metni anlamasına yardımcı olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用聚焦窗口的屏幕截图，帮助建议理解周围文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前聚焦視窗的截圖，協助建議理解周圍文字。"
          }
        }
      }
    },
