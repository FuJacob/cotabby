    "Insert the next word of the suggestion.": {
      "comment": "Used in: UI/Settings/Panes/ShortcutsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدراج الكلمة التالية من الاقتراح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächstes Wort des Vorschlags einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta la siguiente palabra de la sugerencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérer le mot suivant de la suggestion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव का अगला शब्द डालें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisipkan kata berikutnya dari saran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la parola successiva del suggerimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補の次の単語を挿入"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안의 다음 단어 삽입."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserir a próxima palavra da sugestão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить следующее слово подсказки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerinin sonraki kelimesini ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入建议的下一个单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插入建議中的下一個單字。"
          }
        }
      }
    },
    "Insert the whole remaining suggestion at once. For a double tap, click Change and press %@ twice.": {
      "comment": "Used in: UI/Settings/Panes/ShortcutsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدراج الاقتراح المتبقي بالكامل دفعة واحدة. للنقر المزدوج، انقر على تغيير واضغط %@ مرتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesamten verbleibenden Vorschlag auf einmal einfügen. Für einen Doppeltipp auf „Ändern“ klicken und %@ zweimal drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta de una vez el resto de la sugerencia. Para un doble toque, haz clic en Cambiar y pulsa %@ dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérer toute la suggestion restante d’un coup. Pour un double appui, cliquez sur Modifier et appuyez deux fois sur %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी पूरा सुझाव एक साथ डालें। डबल-टैप के लिए Change पर क्लिक करें और %@ को दो बार दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisipkan seluruh sisa saran sekaligus. Untuk ketuk ganda, klik Ubah lalu tekan %@ dua kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci in una sola volta il resto del suggerimento. Per un doppio tocco, fai clic su Modifica e premi %@ due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの候補全体を一度に挿入します。ダブルタップするには「変更」をクリックし、%@を2回押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 제안 전체를 한 번에 삽입합니다. 두 번 누르려면 변경을 클릭하고 %@을(를) 두 번 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserir toda a sugestão restante de uma vez. Para um toque duplo, clique em Alterar e pressione %@ duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить всю оставшуюся подсказку одним нажатием. Для двойного нажатия нажмите «Изменить» и %@ дважды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan önerinin tamamını tek seferde ekle. Çift dokunuş için Değiştir'e tıklayın ve %@ tuşuna iki kez basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性插入剩余的整条建议。要设置双击，请点击“更改”，然后按 %@ 两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次插入剩餘的完整建議。若要連按兩次，請按一下「變更」並按 %@ 兩次。"
          }
        }
      }
    },
