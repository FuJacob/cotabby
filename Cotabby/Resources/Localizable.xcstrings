    },
    "Fine-tune how large suggestions appear. Lower it if the ghost text looks too big.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط حجم ظهور الاقتراحات بدقة. خفّضه إذا بدا النص الوهمي كبيرًا جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie groß Vorschläge angezeigt werden. Verringere den Wert, wenn der Geistertext zu groß wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el tamaño de las sugerencias. Redúcelo si el texto fantasma parece demasiado grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la taille des suggestions. Réduisez-la si le texte fantôme paraît trop grand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझावों का आकार सूक्ष्म रूप से समायोजित करें। घोस्ट टेक्स्ट बहुत बड़ा लगे तो इसे कम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ukuran tampilan saran. Kurangi nilainya jika teks ghost terlihat terlalu besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la dimensione dei suggerimenti. Riducila se il testo fantasma sembra troppo grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補の表示サイズを細かく調整します。ゴーストテキストが大きすぎる場合は小さくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안이 표시되는 크기를 미세 조정합니다. 고스트 텍스트가 너무 커 보이면 낮추세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o tamanho das sugestões. Reduza-o se o texto fantasma parecer grande demais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте размер подсказок. Уменьшите его, если призрачный текст выглядит слишком большим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilerin ne kadar büyük görüneceğini ince ayarlayın. Hayalet metin çok büyük görünüyorsa düşürün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微调建议的显示大小。如果幽灵文本看起来过大，请调低此值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "微調建議顯示大小。如果幽靈文字看起來太大，請調低此值。"
          }
        }
      }
    },
    "Finishes phrases you often type and shows the model examples of how you write. Only Apple Intelligence and the local model use it; it is never sent to an endpoint.": {
      "comment": "Used in: UI/Settings/Panes/TypingHistorySectionView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكمل العبارات التي تكتبها كثيرًا ويعرض للنموذج أمثلة على أسلوب كتابتك. يستخدمه Apple Intelligence والنموذج المحلي فقط؛ ولا يُرسل مطلقًا إلى نقطة نهاية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervollständigt häufig von dir eingegebene Sätze und zeigt dem Modell Beispiele für deinen Schreibstil. Wird nur von Apple Intelligence und dem lokalen Modell verwendet; niemals an einen Endpunkt gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa frases que escribes a menudo y muestra al modelo ejemplos de cómo escribes. Solo lo usan Apple Intelligence y el modelo local; nunca se envía a un endpoint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine les phrases que vous saisissez souvent et montre au modèle des exemples de votre écriture. Seuls Apple Intelligence et le modèle local exploitent ces données ; elles ne sont jamais envoyées à un endpoint."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अक्सर टाइप किए जाने वाले वाक्यांश पूरे करता है और मॉडल को आपके लेखन के उदाहरण दिखाता है। इसका उपयोग केवल Apple Intelligence और स्थानीय मॉडल करते हैं; इसे कभी एंडपॉइंट को नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan frasa yang sering Anda ketik dan menunjukkan contoh gaya tulisan Anda kepada model. Hanya Apple Intelligence dan model lokal yang menggunakannya; data ini tidak pernah dikirim ke endpoint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa le frasi che digiti spesso e mostra al modello esempi del tuo stile di scrittura. Questa funzione è usata solo da Apple Intelligence e dal modello locale; i dati non vengono mai inviati a un endpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく入力するフレーズを仕上げ、あなたの書き方の例をモデルに示します。Apple Intelligenceとローカルモデルだけが使用し、エンドポイントには決して送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 입력하는 구문을 완성하고 모델에 작성 방식의 예를 보여줍니다. Apple Intelligence와 로컬 모델만 사용하며 엔드포인트로는 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa frases que você digita com frequência e mostra ao modelo exemplos de como você escreve. Somente o Apple Intelligence e o modelo local usam isso; nunca é enviado a um endpoint."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает часто вводимые вами фразы и показывает модели примеры вашего стиля. Эту историю используют только Apple Intelligence и локальная модель; на эндпоинт она никогда не отправляется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık yazdığınız ifadeleri tamamlar ve yazım tarzınızı modele örneklerle gösterir. Bu özelliği yalnızca Apple Intelligence ve yerel model kullanır; veriler hiçbir zaman uç noktaya gönderilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成你经常输入的短语，并向模型展示你的写作示例。只有 Apple Intelligence 和本地模型会使用它；它永远不会发送到端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成你常輸入的片語，並向模型展示你的寫作方式。只有 Apple Intelligence 與本機模型會使用這項功能；內容永遠不會傳送到端點。"
          }
        }
      }
    },
