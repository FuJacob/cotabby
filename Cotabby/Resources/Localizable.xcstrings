          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar sugestões enquanto uma palavra parecer escrita incorretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливать автодополнение, если слово похоже на написанное с ошибкой."
