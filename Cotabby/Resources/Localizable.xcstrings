    "What's included": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeTemplateStepView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يتضمنه"
          }
        },
        "de": {
