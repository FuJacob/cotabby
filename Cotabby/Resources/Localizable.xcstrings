        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी का उपयोग कम करने के लिए Low Power Mode चालू होने पर सुझाव रोकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda saran saat Mode Daya Rendah aktif untuk mengurangi penggunaan baterai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa i suggerimenti quando Risparmio energetico è attivo per ridurre il consumo della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー使用量を減らすため、低電力モード中は候補を一時停止します。"
