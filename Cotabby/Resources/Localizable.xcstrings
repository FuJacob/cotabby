    "Token budget scales by your selected language. Multiple languages or a language Cotabby doesn't recognize use the English ratio.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير ميزانية الرموز بحسب اللغة المختارة. وتستخدم اللغات المتعددة أو اللغة التي لا يتعرّف عليها Cotabby النسبة الإنجليزية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tokenbudget wird an deine ausgewählte Sprache angepasst. Mehrere Sprachen oder eine von Cotabby nicht erkannte Sprache verwenden das englische Verhältnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El presupuesto de tokens se adapta al idioma seleccionado. Si eliges varios idiomas o uno que Cotabby no reconoce, se usa la proporción del inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le budget de jetons varie selon la langue sélectionnée. Si plusieurs langues sont sélectionnées ou si Cotabby ne reconnaît pas la langue, le coefficient utilisé est celui de l’anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोकन बजट आपकी चुनी हुई भाषा के अनुसार बदलता है। कई भाषाओं या Cotabby द्वारा न पहचानी गई भाषा के लिए अंग्रेज़ी अनुपात उपयोग होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran token menyesuaikan bahasa yang dipilih. Beberapa bahasa atau bahasa yang tidak dikenali Cotabby menggunakan rasio bahasa Inggris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget di token varia in base alla lingua selezionata. Più lingue o una lingua che Cotabby non riconosce usano il rapporto dell'inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークン予算は選択した言語に応じて変わります。複数の言語、またはCotabbyが認識しない言語では英語の比率を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰 예산은 선택한 언어에 따라 조정됩니다. 여러 언어 또는 Cotabby가 인식하지 못하는 언어에는 영어 비율이 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orçamento de tokens varia conforme o idioma selecionado. Vários idiomas ou um idioma que o Cotabby não reconhece usam a proporção do inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджет токенов зависит от выбранного языка. Для нескольких языков или языка, который Cotabby не распознаёт, используется коэффициент английского языка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirteç bütçesi seçtiğiniz dile göre ölçeklenir. Birden çok dil veya Cotabby'nin tanımadığı bir dil İngilizce oranını kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 预算会按所选语言调整。多种语言或 Cotabby 无法识别的语言使用英语比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 預算會依所選語言調整。選取多種語言或 Cotabby 無法辨識的語言時，會採用英文比例。"
          }
        }
      }
    },
    "Too many requests — please wait a moment and try again.": {
      "comment": "Used in: Services/ModelManagement/HuggingFaceAPIClient.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا — يُرجى الانتظار لحظة ثم المحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen – bitte warte einen Moment und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes — espera un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de requêtes — veuillez patienter un instant et réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक अनुरोध — कृपया कुछ समय प्रतीक्षा करके फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan — tunggu sebentar lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste — attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다 — 잠시 기다렸다가 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas solicitações — aguarde um momento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов — подождите немного и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek var — lütfen biraz bekleyip tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过多 — 请稍候片刻再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求過多 — 請稍候片刻再試一次。"
          }
        }
      }
    },
