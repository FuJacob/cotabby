    "Include the app and window name in suggestions. With an endpoint selected, this context is sent to that server.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضمين اسم التطبيق والنافذة في الاقتراحات. عند اختيار نقطة نهاية، يُرسل هذا السياق إلى ذلك الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App- und Fensternamen in Vorschläge einbeziehen. Wenn ein Endpunkt ausgewählt ist, wird dieser Kontext an diesen Server gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye el nombre de la app y de la ventana en las sugerencias. Si eliges un endpoint, este contexto se envía a ese servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure le nom de l’app et de la fenêtre dans les suggestions. Lorsqu’un endpoint est sélectionné, ce contexte est envoyé à ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझावों में ऐप और विंडो का नाम शामिल करें। एंडपॉइंट चुनने पर यह संदर्भ उस सर्वर को भेजा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan nama app dan jendela dalam saran. Jika endpoint dipilih, konteks ini dikirim ke server tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi nei suggerimenti il nome dell'app e della finestra. Se selezioni un endpoint, queste informazioni vengono inviate a quel server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補にアプリ名とウィンドウ名を含めます。エンドポイントを選択している場合、このコンテキストはそのサーバーに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안에 앱과 윈도우 이름을 포함합니다. 엔드포인트를 선택하면 이 컨텍스트가 해당 서버로 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir o nome do app e da janela nas sugestões. Com um endpoint selecionado, esse contexto é enviado a esse servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять в подсказки название приложения и окна. При выборе эндпоинта этот контекст отправляется на сервер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ve pencere adını önerilere dahil et. Bir uç nokta seçildiğinde bu bağlam o sunucuya gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在建议中包含 App 和窗口名称。选择端点后，此上下文会发送到该服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在建議中包含 App 與視窗名稱。選取端點後，這些內容會傳送至該伺服器。"
          }
        }
      }
    },
    "Indexes load on demand and Cotabby keeps at most two in memory. If no bundled dictionary matches, macOS supplies the correction.": {
      "comment": "Used in: UI/Settings/Components/Controls/SpellingDictionaryPicker.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمّل الفهارس عند الطلب ويحتفظ Cotabby باثنين منها كحد أقصى في الذاكرة. إذا لم يطابق أي قاموس مضمّن، يوفّر macOS التصحيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indizes werden bei Bedarf geladen, und Cotabby hält höchstens zwei im Speicher. Wenn kein gebündeltes Wörterbuch passt, liefert macOS die Korrektur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los índices se cargan bajo demanda y Cotabby mantiene como máximo dos en memoria. Si ningún diccionario incluido coincide, macOS proporciona la corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les index sont chargés à la demande et Cotabby en garde au maximum deux en mémoire. Si aucun dictionnaire inclus ne correspond, macOS fournit la correction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंडेक्स ज़रूरत पड़ने पर लोड होते हैं और Cotabby मेमोरी में अधिकतम दो रखता है। अगर कोई बंडल किया गया शब्दकोश मेल न खाए, तो macOS सुधार देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks dimuat sesuai kebutuhan dan Cotabby menyimpan maksimal dua indeks di memori. Jika tidak ada kamus bawaan yang cocok, macOS menyediakan koreksinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indici vengono caricati su richiesta e Cotabby ne conserva al massimo due in memoria. Se nessun dizionario incluso corrisponde, macOS fornisce la correzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックスは必要に応じて読み込まれ、Cotabbyはメモリ上に最大2つまで保持します。対応するバンドル辞書がない場合は、macOSが修正を提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색인은 필요할 때 불러오며 Cotabby는 메모리에 최대 2개를 유지합니다. 번들 사전과 일치하는 항목이 없으면 macOS가 교정 결과를 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os índices são carregados sob demanda e o Cotabby mantém no máximo dois na memória. Se nenhum dicionário incluído corresponder, o macOS fornece a correção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индексы загружаются по требованию, и Cotabby хранит в памяти не более двух. Если ни один встроенный словарь не подходит, исправление выполняет macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizinler isteğe göre yüklenir ve Cotabby bellekte en fazla iki tane tutar. Paketlenmiş sözlük eşleşmezse düzeltmeyi macOS sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引按需加载，Cotabby 内存中最多保留两个。如果没有匹配的内置词典，macOS 会提供纠正结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引會按需載入，Cotabby 最多會在記憶體中保留兩個索引。如果沒有相符的內建字典，macOS 會提供更正。"
          }
        }
      }
    },
