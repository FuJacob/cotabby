            "value": "Was enthalten ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué incluye"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est inclus"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या शामिल है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang disertakan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è incluso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "含まれるもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 내용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está incluído"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что включено"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含內容"
          }
        }
      }
    },
    "When Apple Intelligence doesn't support the language you're writing in, suggest with %@ instead. Turn off to get no suggestion in those languages.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+AppleIntelligence.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم %@ للاقتراحات عندما لا يدعم Apple Intelligence اللغة التي تكتب بها. أوقف هذا الخيار لعدم عرض اقتراح بتلك اللغات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Apple Intelligence die Sprache, in der du schreibst, nicht unterstützt, stattdessen %@ verwenden. Deaktivieren, um in diesen Sprachen keinen Vorschlag zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Apple Intelligence no admita el idioma en el que escribes, usa %@ para generar sugerencias en su lugar. Desactívalo para no recibir sugerencias en esos idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Apple Intelligence ne prend pas en charge la langue dans laquelle vous écrivez, Cotabby peut utiliser %@ à la place. Désactivez cette option pour ne recevoir aucune suggestion dans ces langues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Apple Intelligence उस भाषा का समर्थन न करे जिसमें आप लिख रहे हैं, तो इसके बजाय %@ से सुझाव दें। उन भाषाओं में सुझाव न पाने के लिए इसे बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Apple Intelligence tidak mendukung bahasa yang Anda gunakan untuk menulis, beri saran dengan %@. Matikan untuk tidak menerima saran dalam bahasa tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Apple Intelligence non supporta la lingua in cui scrivi, usa %@ per i suggerimenti. Disattiva questa opzione per non ricevere suggerimenti in quelle lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceが入力中の言語に対応していない場合は、代わりに%@で候補を表示します。オフにすると、その言語では候補を表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 작성 중인 언어를 지원하지 않으면 대신 %@으로 제안합니다. 끄면 해당 언어로 제안하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Apple Intelligence não oferecer suporte ao idioma em que você escreve, sugerir com %@. Desative para não receber sugestões nesses idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Apple Intelligence не поддерживает язык, на котором вы пишете, используйте вместо неё %@. Выключите этот параметр, чтобы не получать подсказки на этих языках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence yazdığınız dili desteklemediğinde önerileri %@ ile oluşturur. Bu dillerde hiç öneri almamak için kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Apple Intelligence 不支持你正在使用的语言时，改用 %@ 提供建议。关闭后，这些语言不会提供建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 不支援你正在使用的語言時，改用 %@ 提供建議。關閉後，這些語言不會提供建議。"
          }
        }
      }
    },
    "When accepting a suggestion finishes a word, also add a space so you can keep typing. Skipped when it already ends in punctuation or a space.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مسافة أيضًا عند قبول اقتراح يُكمل كلمةً كي تواصل الكتابة. لا تُضاف المسافة إذا انتهى الاقتراح أصلًا بعلامة ترقيم أو مسافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Übernahme eines Vorschlags ein Wort beendet, zusätzlich ein Leerzeichen einfügen, damit du weitertippen kannst. Wird übersprungen, wenn er bereits mit Satzzeichen oder einem Leerzeichen endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando aceptar una sugerencia termine una palabra, añade también un espacio para que puedas seguir escribiendo. Se omite si ya termina en un signo de puntuación o un espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une espace lorsque l’acceptation d’une suggestion termine un mot, pour vous permettre de continuer à saisir. Cette espace n’est pas ajoutée si la suggestion se termine déjà par une ponctuation ou une espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव स्वीकार करने से शब्द पूरा हो तो स्पेस भी जोड़ें ताकि आप टाइप करते रहें। अगर अंत में विराम-चिह्न या स्पेस पहले से हो तो इसे छोड़ दिया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika saran yang diterima melengkapi satu kata, tambahkan spasi agar Anda dapat terus mengetik. Spasi tidak ditambahkan jika saran sudah diakhiri tanda baca atau spasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando accetti una parte del suggerimento che completa una parola, aggiungi anche uno spazio così puoi continuare a scrivere. L’aggiunta viene saltata se il testo inserito termina già con punteggiatura o uno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補の挿入で単語が終わるときは、入力を続けられるようスペースも追加します。末尾が句読点またはスペースの場合は追加しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안을 수락해 단어가 끝나면 계속 입력할 수 있도록 공백도 추가합니다. 이미 문장 부호나 공백으로 끝나는 경우에는 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aceitar uma sugestão terminar uma palavra, adicione também um espaço para continuar digitando. Ignorado quando ela já termina com pontuação ou espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда принятие подсказки завершает слово, добавлять пробел, чтобы можно было продолжить ввод. Пропускается, если подсказка уже заканчивается знаком препинания или пробелом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öneriyi kabul etmek bir kelimeyi tamamladığında, yazmaya devam edebilmeniz için bir boşluk da ekleyin. Öneri zaten noktalama işaretiyle veya boşlukla bitiyorsa atlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入建议并补全一个单词后，也会添加空格，方便继续输入。如果建议已以标点或空格结尾，则不会添加空格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受建議完成一個單字時，同時新增空格，讓你可以繼續輸入。如果結尾已是標點符號或空格，則不會新增。"
          }
        }
      }
    },
    "When you accept a word, also accept the punctuation that follows it (commas, periods) so you don't have to type it.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند قبول كلمة، اقبل أيضًا علامة الترقيم التي تليها (الفواصل والنقاط) كي لا تضطر إلى كتابتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Wort übernimmst, auch das darauffolgende Satzzeichen (Kommas, Punkte) übernehmen, damit du es nicht tippen musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando aceptes una palabra, acepta también la puntuación que la sigue (comas y puntos) para que no tengas que escribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepte également la ponctuation qui suit le mot (virgules, points), pour vous éviter de la saisir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द स्वीकार करते समय उसके बाद आने वाले विराम-चिह्न (कॉमा, पूर्णविराम) भी स्वीकार करें ताकि आपको उन्हें टाइप न करना पड़े।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menerima kata, terima juga tanda baca setelahnya (koma, titik) agar Anda tidak perlu mengetiknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando accetti una parola, accetta anche la punteggiatura che la segue (virgole, punti), così non devi digitarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を挿入すると、その後に続く句読点（コンマ、ピリオド）も一緒に挿入されるため、自分で入力する必要がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 수락할 때 뒤따르는 문장 부호(쉼표, 마침표)도 수락하여 직접 입력하지 않아도 되도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao aceitar uma palavra, aceite também a pontuação que a segue (vírgulas, pontos) para não precisar digitá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При принятии слова также принимать следующие за ним знаки препинания (запятые, точки), чтобы не вводить их вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelimeyi kabul ettiğinizde, sizin yazmanız gerekmemesi için ardından gelen noktalama işaretlerini (virgül, nokta) da ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入一个建议单词时，也会一并插入其后的标点（逗号、句号），无需你手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受單字時，也接受其後的標點符號（逗號、句號），讓你不必自行輸入。"
          }
        }
      }
    },
    "Where Cotabby stays quiet": {
