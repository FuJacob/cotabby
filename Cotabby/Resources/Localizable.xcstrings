    "Offline currency conversions using a bundled approximate rate table. Accepts ISO codes, symbols, and common names.": {
      "comment": "Used in: UI/InlineFeatures/MacroReferenceSheet.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويلات عملات بلا اتصال باستخدام جدول أسعار تقريبي مضمّن. يقبل رموز ISO والرموز والأسماء الشائعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Währungsumrechnungen mit einer gebündelten Tabelle ungefährer Kurse. Akzeptiert ISO-Codes, Symbole und gängige Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversiones de moneda sin conexión mediante una tabla incluida de tipos aproximados. Acepta códigos ISO, símbolos y nombres habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversions de devises hors ligne à l’aide d’une table de taux de change approximatifs incluse. Accepte les codes ISO, les symboles et les noms courants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंडल की गई अनुमानित दर तालिका से ऑफ़लाइन मुद्रा रूपांतरण। ISO कोड, प्रतीक और आम नाम स्वीकार करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversi mata uang offline menggunakan tabel kurs perkiraan bawaan. Menerima kode ISO, simbol, dan nama umum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversioni di valuta offline usando una tabella di tassi approssimativi inclusa. Accetta codici ISO, simboli e nomi comuni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドルされた概算レート表を使うオフライン通貨換算。ISOコード、記号、一般的な名称に対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들된 대략적인 환율표를 사용하는 오프라인 통화 변환입니다. ISO 코드, 기호 및 일반 이름을 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversões de moeda offline usando uma tabela aproximada incluída. Aceita códigos ISO, símbolos e nomes comuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автономное преобразование валют с помощью встроенной таблицы приблизительных курсов. Принимаются коды ISO, символы и распространённые названия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı para birimi dönüşümleri; yaklaşık kur tablosu paketlenmiştir. ISO kodlarını, sembolleri ve yaygın adları kabul eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用内置近似汇率表进行离线货币换算。支持 ISO 代码、符号和常用名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用內建近似匯率表進行離線貨幣轉換。接受 ISO 代碼、符號與常用名稱。"
          }
        }
      }
    },
