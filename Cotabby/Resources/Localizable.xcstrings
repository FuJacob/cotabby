    "Language support depends on your selected model. Apple Intelligence covers a fixed set of languages, and local models vary, so some languages may not work.": {
      "comment": "Used in: UI/Settings/Components/Controls/LanguageTagsEditor.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد دعم اللغات على النموذج الذي اخترته. يغطي Apple Intelligence مجموعة ثابتة من اللغات، وتختلف النماذج المحلية، لذلك قد لا تعمل بعض اللغات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachunterstützung hängt vom ausgewählten Modell ab. Apple Intelligence unterstützt eine feste Auswahl an Sprachen, und lokale Modelle unterscheiden sich; daher funktionieren manche Sprachen möglicherweise nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilidad de idiomas depende del modelo seleccionado. Apple Intelligence cubre un conjunto fijo de idiomas y los modelos locales varían, por lo que algunos idiomas podrían no funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prise en charge des langues dépend du modèle sélectionné. Apple Intelligence couvre un ensemble fixe de langues et les modèles locaux varient ; certaines langues peuvent donc ne pas fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा समर्थन आपके चुने मॉडल पर निर्भर करता है। Apple Intelligence भाषाओं का निश्चित सेट कवर करता है, और स्थानीय मॉडल अलग-अलग होते हैं, इसलिए कुछ भाषाएँ काम नहीं कर सकतीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukungan bahasa bergantung pada model yang dipilih. Apple Intelligence mencakup sekumpulan bahasa tertentu, sedangkan model lokal berbeda-beda, jadi beberapa bahasa mungkin tidak berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il supporto linguistico dipende dal modello selezionato. Apple Intelligence copre un insieme fisso di lingue, mentre i modelli locali variano, quindi alcune lingue potrebbero non funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語のサポートは選択したモデルによって異なります。Apple Intelligenceが対応する言語は固定され、ローカルモデルも異なるため、一部の言語は動作しない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 지원은 선택한 모델에 따라 달라집니다. Apple Intelligence는 고정된 언어 집합을 지원하고 로컬 모델은 지원 언어가 다르므로 일부 언어는 작동하지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte a idiomas depende do modelo selecionado. O Apple Intelligence abrange um conjunto fixo de idiomas, e os modelos locais variam, então alguns idiomas podem não funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка языков зависит от выбранной модели. Apple Intelligence поддерживает фиксированный набор языков, а локальные модели различаются, поэтому некоторые языки могут не работать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil desteği seçtiğiniz modele bağlıdır. Apple Intelligence sabit bir dil kümesini destekler ve yerel modeller değişiklik gösterir; bu nedenle bazı diller çalışmayabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言支持取决于所选模型。Apple Intelligence 覆盖固定语言集合，本地模型各不相同，因此某些语言可能无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言支援取決於所選模型。Apple Intelligence 僅支援固定的一組語言，本機模型則各有不同，因此部分語言可能無法使用。"
          }
        }
      }
    },
