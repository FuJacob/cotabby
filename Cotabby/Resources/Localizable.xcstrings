    "Pick one to get set up. You can fine-tune everything later in Settings.": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeTemplateStepView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر واحدًا للبدء. يمكنك ضبط كل شيء لاحقًا في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Option, um loszulegen. Du kannst später alles in den Einstellungen anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una opción para empezar. Puedes ajustar todo más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en un pour commencer. Vous pourrez tout ajuster plus tard dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअप के लिए कोई एक चुनें। बाद में सेटिंग्ज़ में सब कुछ सूक्ष्म रूप से बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu untuk memulai. Anda dapat mengatur semuanya lebih lanjut nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline una per iniziare. Puoi perfezionare tutto più tardi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ選んで設定してください。詳しい調整は後で設定から行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 선택해 설정하세요. 나중에 설정에서 모든 항목을 미세 조정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma opção para começar. Você pode ajustar tudo depois em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите вариант для настройки. Всё остальное можно настроить позже в параметрах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuruluma başlamak için birini seçin. Her şeyi daha sonra Ayarlar'dan ince ayarlayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个开始设置。你可以稍后在设置中微调所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一項開始設定。稍後可在「設定」中微調所有內容。"
          }
        }
      }
    },
