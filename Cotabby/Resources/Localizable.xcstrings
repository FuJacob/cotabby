    "Each project ships under its own license; see the linked repository for the verbatim text.": {
      "comment": "Used in: UI/Settings/Panes/About/AcknowledgementsView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُوزّع كل مشروع بموجب ترخيصه الخاص؛ راجع المستودع المرتبط للنص الحرفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Projekt steht unter seiner eigenen Lizenz; den vollständigen Text findest du im verlinkten Repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proyecto se distribuye con su propia licencia; consulta el repositorio enlazado para ver el texto íntegro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque projet est distribué sous sa propre licence ; consultez le dépôt lié pour le texte intégral."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रोजेक्ट अपने लाइसेंस के तहत आता है; मूल पाठ के लिए लिंक की गई रिपॉज़िटरी देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap proyek didistribusikan dengan lisensinya sendiri; lihat repositori tertaut untuk teks lengkapnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni progetto è distribuito con la propria licenza; consulta il repository collegato per il testo integrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロジェクトは独自のライセンスで提供されています。逐語的な本文はリンク先のリポジトリを参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
