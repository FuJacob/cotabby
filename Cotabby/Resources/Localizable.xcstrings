    "Pause suggestions while Low Power Mode is on to reduce battery use.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+Power.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الاقتراحات مؤقتًا عند تفعيل نمط الطاقة المنخفضة لتقليل استهلاك البطارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge zur Akkuschonung pausieren, während der Stromsparmodus aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa las sugerencias mientras el modo de bajo consumo esté activado para reducir el consumo de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les suggestions en pause lorsque le mode économie d’énergie est activé pour réduire l’utilisation de la batterie."
