    "Remove this app's overrides. Cotabby will use the global accept keys here.": {
      "comment": "Used in: UI/Settings/Panes/AppsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة تجاوزات هذا التطبيق. سيستخدم Cotabby مفاتيح القبول العامة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Überschreibungen entfernen. Cotabby verwendet hier die globalen Übernahmetasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las excepciones de esta app. Cotabby usará aquí las teclas de aceptación globales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les remplacements de cette app. Cotabby utilisera ici les touches d’acceptation globales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप के ओवरराइड हटाएँ। Cotabby यहाँ वैश्विक स्वीकार कुंजियों का उपयोग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus penggantian app ini. Cotabby akan menggunakan tombol penerimaan global di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi le impostazioni personalizzate di questa app. Qui Cotabby userà i tasti di accettazione globali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの上書きを削除します。Cotabbyはここでグローバルの候補挿入キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에 설정된 단축키를 제거합니다. Cotabby가 여기에서 전역 수락 키를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover as substituições deste app. O Cotabby usará aqui as teclas de aceitação globais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить переопределения этого приложения. Здесь Cotabby будет использовать глобальные клавиши принятия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için özel ayarları kaldırın. Cotabby burada genel kabul tuşlarını kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此 App 的快捷键覆盖设置。Cotabby 将在此处使用全局建议插入快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此 App 的覆寫設定。Cotabby 會在這裡使用全域接受按鍵。"
          }
        }
      }
    },
    "Replace a misspelled word right after you press Space.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال كلمة بها خطأ إملائي فور الضغط على مسافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein falsch geschriebenes Wort direkt nach dem Drücken der Leertaste ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza una palabra mal escrita justo después de pulsar Espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer un mot mal orthographié juste après avoir appuyé sur Espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Space दबाते ही गलत वर्तनी वाले शब्द को बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti kata yang salah eja segera setelah Anda menekan Spasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci una parola errata subito dopo aver premuto Spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押した直後にスペルミスの単語を置換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누른 직후 철자가 틀린 단어 교체"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir uma palavra com erro logo após pressionar Espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменять слово с ошибкой сразу после нажатия пробела."
          }
        },
