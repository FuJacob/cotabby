    "Optional visual context from the focused window.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سياق مرئي اختياري من النافذة النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler visueller Kontext aus dem fokussierten Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto visual opcional de la ventana enfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte visuel facultatif de la fenêtre active."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस की गई विंडो से वैकल्पिक दृश्य संदर्भ।"
          }
        },
        "id": {
          "stringUnit": {
