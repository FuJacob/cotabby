    "Unavailable while Screen Recording is off. Grant permission to help suggestions understand surrounding text.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متاح أثناء إيقاف تسجيل الشاشة. امنح الإذن لمساعدة الاقتراحات على فهم النص المحيط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfügbar, solange Bildschirmaufnahme deaktiviert ist. Erteile die Berechtigung, damit Vorschläge den umgebenden Text verstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible mientras Grabación de pantalla esté desactivada. Concede el permiso para ayudar a las sugerencias a entender el texto circundante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible lorsque l’autorisation Enregistrement de l’écran est désactivée. Accordez-la pour aider les suggestions à comprendre le texte environnant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन रिकॉर्डिंग बंद होने पर उपलब्ध नहीं। सुझावों को आसपास का टेक्स्ट समझने में मदद करने के लिए अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia saat Perekaman Layar mati. Berikan izin agar saran memahami teks di sekitarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile quando Registrazione schermo è disattivata. Concedi l'autorizzazione per aiutare i suggerimenti a comprendere il testo circostante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録がオフのため利用できません。候補が周囲のテキストを理解できるよう、権限を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록이 꺼져 있는 동안 사용할 수 없습니다. 제안이 주변 텍스트를 이해하도록 권한을 부여하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível enquanto a Gravação de Tela está desativada. Conceda a permissão para ajudar as sugestões a entender o texto ao redor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно, пока запись экрана выключена. Предоставьте разрешение, чтобы подсказки могли понимать окружающий текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı kapalıyken kullanılamaz. Önerilerin çevreleyen metni anlamasına yardımcı olmak için izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制关闭时不可用。请授予权限，帮助建议理解周围文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕錄製」關閉時無法使用。授予權限，協助建議理解周圍文字。"
          }
        }
      }
    },
    "Unbind this shortcut. No key will accept the whole suggestion at once.": {
      "comment": "Used in: UI/Settings/Panes/ShortcutsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تعيين هذا الاختصار. لن يقبل أي مفتاح الاقتراح بالكامل دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Kurzbefehl entfernen. Keine Taste übernimmt dann den gesamten Vorschlag auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la asignación de este atajo. Ninguna tecla aceptará toda la sugerencia de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier ce raccourci. Aucune touche n’acceptera toute la suggestion en une fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शॉर्टकट का बंधन हटाएँ। कोई कुंजी पूरा सुझाव एक साथ स्वीकार नहीं करेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus pintasan ini. Tidak ada tombol yang akan menerima seluruh saran sekaligus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi questa scorciatoia. Nessun tasto accetterà l'intero suggerimento in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットの割り当てを解除します。候補全体を一度に挿入するキーはなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키의 연결을 해제합니다. 한 번에 전체 제안을 수락하는 키가 없어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincule este atalho. Nenhuma tecla aceitará a sugestão inteira de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять назначение этого сочетания клавиш. Ни одна клавиша не будет принимать всю подсказку сразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayolun tuş atamasını kaldırın. Önerinin tamamını bir seferde kabul edecek hiçbir tuş olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消绑定此快捷键。之后不会再有按键一次性插入整条建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除綁定此快速鍵。沒有按鍵會一次接受完整建議。"
          }
        }
      }
    },
