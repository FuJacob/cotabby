    "Fade new suggestions in smoothly instead of all at once.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الاقتراحات الجديدة بتلاشي سلس بدلًا من ظهورها دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Vorschläge sanft einblenden statt alle auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que las nuevas sugerencias aparezcan suavemente en lugar de mostrarse de golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire apparaître progressivement les nouvelles suggestions au lieu de toutes les afficher d’un coup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए सुझावों को एक साथ दिखाने के बजाय धीरे-धीरे दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Munculkan saran baru secara halus, bukan sekaligus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai comparire gradualmente i nuovi suggerimenti, invece di mostrarli tutti insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい候補を一度に表示せず、滑らかにフェードインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 제안을 한꺼번에 표시하지 않고 부드럽게 페이드 인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça novas sugestões aparecerem suavemente em vez de todas de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавно проявлять новые подсказки вместо мгновенного появления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni önerileri bir anda göstermek yerine yavaşça görünür hale getirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让新建议平滑淡入，而不是一次性全部出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓新建議平順淡入，而不是一次全部顯示。"
          }
        }
      }
    },
