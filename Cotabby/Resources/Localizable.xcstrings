    "The key, or the Accept Word key pressed twice, that inserts the whole suggestion.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح الذي يُدرج الاقتراح بالكامل، أو مفتاح قبول الكلمة عند الضغط عليه مرتين."
