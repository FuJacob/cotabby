          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Taste führt %@ in %@ aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No key will perform %1$@ in %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tecla ejecutará %@ en %@."
          }
        },
