    },
    "Drag toward Fast to make a new suggestion fade in more quickly.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب نحو «سريع» لتظهر الاقتراحات الجديدة بتلاشي تدريجي أسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe in Richtung Schnell, damit ein neuer Vorschlag schneller eingeblendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra hacia Rápido para que una nueva sugerencia aparezca antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers Rapide pour accélérer l’apparition d’une nouvelle suggestion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया सुझाव तेज़ी से दिखाने के लिए Fast की ओर खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ke arah Cepat agar saran baru muncul lebih cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina verso l'opzione Veloce per far comparire più rapidamente un nuovo suggerimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい候補をより早く表示するには「高速」の方向へドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 제안이 더 빨리 나타나도록 빠름 쪽으로 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste em direção a Rápido para fazer uma nova sugestão aparecer mais rapidamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите к «Быстро», чтобы новая подсказка появлялась быстрее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni önerinin daha hızlı görünmeye başlaması için Hızlı’ya doğru sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向“快速”拖动，可让新建议更快淡入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將滑桿往「快速」方向拖曳，讓新建議更快淡入。"
          }
        }
      }
    },
