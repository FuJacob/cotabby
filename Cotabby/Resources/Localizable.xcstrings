          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Cotabby와 해당 데이터를 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o Cotabby e seus dados deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить Cotabby и его данные с этого Mac."
          }
        },
        "tr": {
          "stringUnit": {
