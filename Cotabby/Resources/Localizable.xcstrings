          }
        }
      }
    },
    "After you finish a word, shows a green replacement you can apply with your accept key.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إكمال كلمة، يعرض استبدالًا أخضر يمكنك تطبيقه بمفتاح القبول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss eines Wortes wird eine grüne Ersetzung angezeigt, die du mit deiner Übernahmetaste anwenden kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de terminar una palabra, muestra un reemplazo verde que puedes aplicar con la tecla de aceptación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la fin d’un mot, affiche un remplacement vert que vous pouvez appliquer avec votre touche d’acceptation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द पूरा करने के बाद हरा प्रतिस्थापन दिखाता है, जिसे आप अपनी स्वीकार कुंजी से लागू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah Anda menyelesaikan kata, Cotabby menampilkan penggantian berwarna hijau yang dapat diterapkan dengan tombol penerimaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver completato una parola, mostra una sostituzione verde che puoi applicare con il tasto di accettazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を入力し終えると、候補挿入キーで適用できる緑色の置換候補を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 입력을 마치면 수락 키로 적용할 수 있는 초록색 교정 결과를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que você terminar uma palavra, mostra uma substituição verde que pode ser aplicada com a tecla de aceitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После завершения слова показывает зелёную замену, которую можно применить клавишей принятия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelimeyi bitirdiğinizde, kabul tuşunuzla uygulayabileceğiniz yeşil bir değiştirme önerir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入完一个单词后，会显示绿色替换建议，按插入键即可应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一個單字後顯示綠色取代文字，你可以用接受快速鍵套用。"
          }
        }
      }
    },
    "After you press Space, replaces a misspelled word without requiring your accept key.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الضغط على المسافة، يستبدل كلمة بها خطأ إملائي من دون الحاجة إلى مفتاح القبول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Drücken der Leertaste wird ein falsch geschriebenes Wort ersetzt, ohne dass du deine Übernahmetaste drücken musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de pulsar Espacio, reemplaza una palabra mal escrita sin necesitar la tecla de aceptación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir appuyé sur Espace, remplace un mot mal orthographié sans nécessiter votre touche d’acceptation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Space दबाने के बाद, स्वीकार कुंजी की ज़रूरत के बिना गलत वर्तनी वाले शब्द को बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah Anda menekan Spasi, Cotabby mengganti kata yang salah eja tanpa perlu menekan tombol penerimaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver premuto Spazio, sostituisce una parola con errori senza richiedere il tasto di accettazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押すと、候補挿入キーを使わずにスペルミスの単語を置換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누르면 수락 키를 누르지 않아도 철자가 틀린 단어를 교체합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que você pressionar Espaço, substitui uma palavra com erro sem exigir a tecla de aceitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После нажатия пробела заменяет слово с ошибкой без клавиши принятия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk tuşuna bastıktan sonra, kabul tuşunuza gerek kalmadan yanlış yazılmış bir kelimeyi değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下空格后，无需按插入键即可替换拼写错误的单词。"
          }
        },
        "zh-Hant": {
