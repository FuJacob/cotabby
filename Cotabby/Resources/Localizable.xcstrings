    "Allow continuations that span more than one line.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالمتابعات التي تمتد لأكثر من سطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzungen erlauben, die sich über mehr als eine Zeile erstrecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite continuaciones que ocupen más de una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les continuations sur plusieurs lignes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक से अधिक पंक्तियों में जारी रहने वाले सुझावों की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan kelanjutan yang mencakup lebih dari satu baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti continuazioni che si estendono su più di una riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行を超える続きの文章を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 줄 이상에 걸친 이어쓰기 허용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir continuações que ocupem mais de uma linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить продолжения, занимающие больше одной строки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla satıra yayılan devam metinlerine izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许跨越多行的续写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許跨越多行的接續內容。"
          }
        }
      }
    },
    "Allow continuations that span more than one line. Off keeps suggestions to a single line.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالمتابعات التي تمتد لأكثر من سطر. عند الإيقاف تبقى الاقتراحات في سطر واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzungen erlauben, die sich über mehr als eine Zeile erstrecken. Deaktiviert beschränkt Vorschläge auf eine Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite continuaciones que ocupen más de una línea. Desactivado mantiene las sugerencias en una sola línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les continuations sur plusieurs lignes. Désactivé, les suggestions restent sur une seule ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक से अधिक पंक्तियों में जारी रहने वाले सुझावों की अनुमति दें। बंद करने पर सुझाव एक ही पंक्ति तक सीमित रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan kelanjutan yang mencakup lebih dari satu baris. Jika mati, saran dibatasi satu baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti continuazioni che si estendono su più di una riga. Se disattivato, i suggerimenti restano su una sola riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行を超える続きの文章を許可します。オフにすると候補を1行に制限します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 줄 이상에 걸친 이어쓰기를 허용합니다. 끄면 제안이 한 줄로 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir continuações que ocupem mais de uma linha. Com a opção desativada, as sugestões ficam em uma única linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить продолжения, занимающие больше одной строки. В выключенном состоянии подсказки остаются однострочными."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla satıra yayılan devam metinlerine izin verin. Kapalı olduğunda öneriler tek satırda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许跨越多行的续写。关闭后，建议仅保留一行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許跨越多行的接續內容。關閉後建議會限制為單行。"
          }
        }
      }
    },
    "Already used by %@. Press it twice quickly for a double tap.": {
      "comment": "Used in: UI/Settings/Components/Controls/KeyRecorderView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
