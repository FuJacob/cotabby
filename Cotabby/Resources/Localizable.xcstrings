        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहीत इतिहास पढ़ा नहीं जा सकता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat tersimpan tidak dapat dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la cronologia memorizzata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された履歴を読み取れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 읽을 수 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o histórico armazenado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённую историю не удалось прочитать"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanan geçmiş okunamıyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取存储的历史记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的記錄"
          }
        }
      }
    },
    "Stored locally on this Mac. Included in requests to your selected engine, including a configured endpoint.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزّن محليًا على جهاز Mac هذا، ويُضمّن في الطلبات المرسلة إلى المحرك المحدد، بما في ذلك نقطة النهاية المُعدّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal auf diesem Mac gespeichert. Wird in Anfragen an die ausgewählte Engine einbezogen, einschließlich eines konfigurierten Endpunkts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado localmente en este Mac. Se incluye en las solicitudes al motor seleccionado, incluido cualquier endpoint configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké localement sur ce Mac. Inclus dans les requêtes envoyées au moteur sélectionné, y compris à un endpoint configuré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर स्थानीय रूप से संग्रहीत। कॉन्फ़िगर किए गए एंडपॉइंट सहित आपके चुने हुए इंजन के अनुरोधों में शामिल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan secara lokal di Mac ini. Disertakan dalam permintaan ke engine yang dipilih, termasuk endpoint yang dikonfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizzato localmente su questo Mac. È incluso nelle richieste inviate al motore selezionato, compreso l’eventuale endpoint configurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにローカル保存されます。設定したエンドポイントを含む、選択したエンジンへのリクエストに含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 로컬로 저장됩니다. 구성된 엔드포인트를 포함해 선택한 엔진에 대한 요청에 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado localmente neste Mac. Incluído nas solicitações ao mecanismo selecionado, inclusive a um endpoint configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится локально на этом Mac. Включается в запросы к выбранному движку, в том числе к настроенному эндпоинту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te yerel olarak saklanır. Yapılandırılmış bir uç nokta dahil seçtiğiniz motora yapılan isteklere dahil edilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在此 Mac 本地。会包含在发送到所选引擎的请求中，包括配置的端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存在此 Mac 上。會包含在傳送給所選引擎的要求中，包括已設定的端點。"
          }
        }
      }
    },
