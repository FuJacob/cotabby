    "Use a different engine or model by power source.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام محرك أو نموذج مختلف حسب مصدر الطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nach Stromquelle eine andere Engine oder ein anderes Modell verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un motor o modelo diferente según la fuente de alimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser un autre moteur ou modèle selon la source d’alimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर स्रोत के अनुसार अलग इंजन या मॉडल उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan engine atau model berbeda berdasarkan sumber daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un motore o modello diverso in base alla fonte di alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に応じて別のエンジンまたはモデルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 소스별로 다른 엔진 또는 모델 사용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um mecanismo ou modelo diferente por fonte de energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать другой движок или модель в зависимости от источника питания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç kaynağına göre farklı bir motor veya model kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电源使用不同的引擎或模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依電源使用不同的引擎或模型。"
          }
        }
      }
    },
    "Use a different engine or model on battery vs. while plugged in. For example, Apple Intelligence on battery to save power and a larger local model while charging.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+Power.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم محركًا أو نموذجًا مختلفًا على البطارية وعند توصيل الجهاز بالطاقة. مثلًا، استخدم Apple Intelligence على البطارية لتوفير الطاقة ونموذجًا محليًا أكبر أثناء الشحن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Batteriebetrieb und bei Netzbetrieb eine andere Engine oder ein anderes Modell verwenden. Zum Beispiel Apple Intelligence im Batteriebetrieb, um Energie zu sparen, und ein größeres lokales Modell beim Laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un motor o modelo diferente con batería y conectado a la corriente. Por ejemplo, Apple Intelligence con batería para ahorrar energía y un modelo local más grande mientras se carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser un moteur ou modèle différent sur batterie et sur secteur. Par exemple, Apple Intelligence sur batterie pour économiser l’énergie et un modèle local plus grand pendant la recharge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी पर और प्लग इन होने पर अलग इंजन या मॉडल उपयोग करें। उदाहरण के लिए, पावर बचाने के लिए बैटरी पर Apple Intelligence और चार्जिंग के दौरान बड़ा स्थानीय मॉडल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan engine atau model berbeda saat memakai baterai dibandingkan saat tersambung ke daya. Misalnya, Apple Intelligence saat memakai baterai untuk menghemat daya dan model lokal yang lebih besar saat mengisi daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un motore o modello diverso a batteria rispetto a quando è collegato all'alimentazione. Ad esempio, Apple Intelligence a batteria per risparmiare energia e un modello locale più grande durante la ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー使用時と電源接続時で別のエンジンまたはモデルを使用します。たとえば、電力を節約するためバッテリー使用時はApple Intelligence、充電中はより大きなローカルモデルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 사용 중과 전원 연결 시 다른 엔진 또는 모델을 사용합니다. 예를 들어 전원을 절약하려면 배터리에서 Apple Intelligence를 사용하고 충전 중에는 더 큰 로컬 모델을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um mecanismo ou modelo diferente na bateria e quando conectado à tomada. Por exemplo, Apple Intelligence na bateria para economizar energia e um modelo local maior durante o carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать другой движок или модель при работе от аккумулятора и при подключённом питании. Например, Apple Intelligence от аккумулятора для экономии энергии и более крупную локальную модель при зарядке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pildeyken ve prize takılıyken farklı motor veya model kullanın. Örneğin güç tasarrufu için pilde Apple Intelligence, şarj olurken daha büyük bir yerel model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池和接通电源时采用不同的引擎或模型。例如，使用电池时用 Apple Intelligence 以节省电量，充电时使用更大的本地模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用電池與接上電源時，可採用不同的引擎或模型。例如使用電池時採用 Apple Intelligence 以節省電力，充電時使用較大型的本機模型。"
          }
        }
      }
    },
    "Use screen context": {
      "comment": "Used in: UI/MenuBar/MenuBarView.swift, UI/Settings/Panes/GeneralPaneView.swift, UI/Settings/SettingsIndex.swift",
      "localizations": {
