    "Downloaded file is %lld bytes; expected %lld. The download may have been truncated.": {
      "comment": "Used in: Services/ModelManagement/ModelFileValidator.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الملف الذي تم تنزيله %lld بايت؛ المتوقع %lld. قد يكون التنزيل مبتورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Datei ist %lld Byte groß; erwartet wurden %lld. Der Download wurde möglicherweise abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Downloaded file is %1$lld bytes; expected %2$lld. The download may have been truncated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo descargado ocupa %lld bytes; se esperaban %lld. Es posible que la descarga se haya truncado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier téléchargé fait %lld octets ; %lld étaient attendus. Le téléchargement est peut-être tronqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड की गई फ़ाइल %lld बाइट की है; अपेक्षित %lld था। डाउनलोड अधूरा हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang diunduh berukuran %lld byte; yang diharapkan %lld. Unduhan mungkin terpotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file scaricato è di %lld byte; attesi %lld. Il download potrebbe essere stato troncato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルは%lldバイトです。想定値は%lldバイトです。ダウンロードが途中で切れた可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 파일은 %lld바이트이고 예상값은 %lld입니다. 다운로드가 중간에 잘렸을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo baixado tem %lld bytes; o esperado era %lld. O download pode ter sido truncado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld байт в загруженном файле; ожидалось %lld. Возможно, загрузка оборвалась."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosya %lld bayt; beklenen %lld. İndirme kesilmiş olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件为 %lld 字节；预期为 %lld 字节。下载可能已被截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
