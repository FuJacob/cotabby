    "Remove %@ from Cotabby's local models folder?": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %@ من مجلد النماذج المحلية في Cotabby؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus dem lokalen Modellordner von Cotabby entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ de la carpeta de modelos locales de Cotabby?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ du dossier des modèles locaux de Cotabby ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby के स्थानीय मॉडल फ़ोल्डर से %@ हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@ dari folder model lokal Cotabby?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@ dalla cartella dei modelli locali di Cotabby?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyのローカルモデルフォルダから%@を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby의 로컬 모델 폴더에서 %@을(를) 제거할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@ da pasta de modelos locais do Cotabby?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ из папки локальных моделей Cotabby?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cotabby'nin yerel modeller klasöründen kaldırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 Cotabby 的本地模型文件夹中移除 %@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從 Cotabby 的本機模型資料夾移除 %@ 嗎？"
          }
        }
      }
    },
    "Remove Cotabby and its data from this Mac.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
