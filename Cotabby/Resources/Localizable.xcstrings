    "Locale-aware dates and times. Supports weekday navigation, relative offsets, and format hints like (iso), (long), (short), (24h).": {
      "comment": "Used in: UI/InlineFeatures/MacroReferenceSheet.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواريخ وأوقات تراعي الإعدادات المحلية. تدعم التنقّل حسب أيام الأسبوع والإزاحات النسبية وتلميحات التنسيق مثل (iso) و(long) و(short) و(24h)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Sprache und Region angepasste Datums- und Zeitangaben. Unterstützt Navigation nach Wochentagen, relative Verschiebungen und Formatvorgaben wie (iso), (long), (short), (24h)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas y horas adaptadas a la configuración regional. Admite navegación por días de la semana, desplazamientos relativos e indicaciones de formato como (iso), (largo), (corto) y (24h)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates et heures adaptées aux paramètres régionaux. Prend en charge la navigation par jour de la semaine, les décalages relatifs et les indications de format telles que (iso), (long), (short), (24h)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेल-अनुकूल तारीखें और समय। सप्ताह के दिन नेविगेशन, सापेक्ष ऑफ़सेट और (iso), (long), (short), (24h) जैसे फ़ॉर्मैट संकेत समर्थित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal dan waktu yang mengikuti pengaturan bahasa dan wilayah. Mendukung navigasi hari, offset relatif, dan petunjuk format seperti (iso), (long), (short), (24h)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Date e orari in base alle impostazioni locali. Supporta la navigazione per giorno della settimana, gli scostamenti relativi e gli indicatori di formato come (iso), (long), (short), (24h)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロケール対応の日付と時刻。曜日の移動、相対オフセット、「(iso)」「(long)」「(short)」「(24h)」などの形式ヒントに対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로케일에 맞는 날짜 및 시간. 요일 탐색, 상대 오프셋 및 (iso), (long), (short), (24h) 같은 형식 힌트를 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Datas e horas adaptadas à localidade. Aceita navegação por dias da semana, deslocamentos relativos e dicas de formato como (iso), (long), (short), (24h)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты и время с учётом локали. Поддерживаются переходы по дням недели, относительные смещения и подсказки формата вроде (iso), (long), (short), (24h)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ayara göre tarih ve saatler. Haftanın günlerine göre gezinmeyi, göreli tarih farklarını ve (iso), (long), (short), (24h) gibi biçim ipuçlarını destekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适配区域设置的日期和时间。支持工作日导航、相对偏移，以及 (iso)、(long)、(short)、(24h) 等格式提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依地區設定顯示日期與時間。支援星期導航、相對偏移，以及 (iso)、(long)、(short)、(24h) 等格式提示。"
          }
        }
      }
    },
    "Logging façade Cotabby uses across runtime, focus, and suggestion subsystems.": {
      "comment": "Used in: UI/Settings/Panes/About/AcknowledgementsView.swift",
      "localizations": {
        "ar": {
