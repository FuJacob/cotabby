    "The Apple on-device model is still preparing or downloading.": {
      "comment": "Used in: Services/Runtime/AppleIntelligence/FoundationModelAvailabilityService.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال النموذج الموجود على الجهاز من Apple قيد التجهيز أو التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple-On-Device-Modell wird noch vorbereitet oder heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de Apple en el dispositivo todavía se está preparando o descargando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple exécuté sur l’appareil est encore en préparation ou en cours de téléchargement."
