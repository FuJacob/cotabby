    "Let a new suggestion fade in smoothly instead of appearing all at once. Follows the system Reduce Motion setting.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للاقتراح الجديد بالظهور بتلاشي سلس بدلًا من ظهوره دفعة واحدة. يتبع إعداد تقليل الحركة في النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Vorschläge sanft einblenden statt alle auf einmal. Folgt der Systemeinstellung „Bewegung reduzieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que una nueva sugerencia aparezca suavemente en lugar de mostrarse de golpe. Sigue el ajuste del sistema Reducir movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire apparaître progressivement une nouvelle suggestion au lieu de l’afficher d’un coup. Respecte le réglage système « Réduire les animations »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए सुझाव को एक साथ दिखाने के बजाय धीरे-धीरे दिखाएँ। यह सिस्टम की Reduce Motion सेटिंग का पालन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan saran baru muncul secara halus, bukan sekaligus. Mengikuti pengaturan Kurangi Gerakan sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai comparire gradualmente i nuovi suggerimenti invece di mostrarli tutti insieme. Segue l’impostazione di sistema “Riduci movimento”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい候補を一度に表示せず、滑らかにフェードインします。システムの「視差効果を減らす」設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 제안이 한꺼번에 나타나지 않고 부드럽게 페이드 인되도록 합니다. 시스템의 동작 줄이기 설정을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma nova sugestão aparecer suavemente em vez de surgir toda de uma vez. Segue o ajuste Reduzir Movimento do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавно показывать новую подсказку вместо мгновенного появления. Учитывает системную настройку «Уменьшение движения»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir önerinin bir anda görünmek yerine yumuşakça görünmesini sağlayın. Sistem Hareketi Azalt ayarını izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让新建议平滑淡入，而不是一次性出现。遵循系统的“减弱动态效果”设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓新建議平順淡入，而不是一次全部出現。會遵循系統的「減少動態效果」設定。"
          }
        }
      }
    },
    "Let suggestions reference what you last copied.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للاقتراحات بالرجوع إلى آخر ما نسخته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge dürfen den zuletzt kopierten Text berücksichtigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las sugerencias consulten lo último que copiaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettre aux suggestions de se référer à ce que vous avez copié en dernier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझावों को आपके पिछली बार कॉपी किए गए टेक्स्ट का संदर्भ लेने दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan saran merujuk pada yang terakhir Anda salin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti ai suggerimenti di usare ciò che hai copiato per ultimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後にコピーした内容を候補から参照できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 복사한 내용을 제안에서 참조하도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que as sugestões consultem o que você copiou por último."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить подсказкам использовать последний скопированный фрагмент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilerin en son kopyaladığınız şeye başvurmasına izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让建议参考你上次复制的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓建議參考你上次複製的內容。"
          }
        }
      }
    },
    "Let suggestions reference whatever you most recently copied.": {
