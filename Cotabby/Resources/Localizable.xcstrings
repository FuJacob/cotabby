    "For non-default tones, suggestions show your selected tone first and keep the default emoji next.": {
      "comment": "Used in: UI/Settings/Panes/EmojiPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في درجات لون البشرة غير الافتراضية، تعرض الاقتراحات درجتك المختارة أولًا ثم الرمز التعبيري الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei nicht standardmäßigen Tönen wird zuerst der ausgewählte Ton angezeigt, danach das Standard-Emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tonos distintos del predeterminado, las sugerencias muestran primero el tono seleccionado y después mantienen el emoji predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous choisissez un ton autre que celui par défaut, les suggestions affichent d’abord le ton choisi, puis l’emoji par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट से अलग त्वचा-रंग के लिए सुझाव पहले आपका चुना हुआ रंग और फिर डिफ़ॉल्ट इमोजी दिखाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda memilih warna kulit selain warna standar, saran menampilkan pilihan Anda terlebih dahulu, lalu emoji default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le tonalità non predefinite, i suggerimenti mostrano prima la tonalità selezionata e poi l'emoji predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト以外のトーンでは、選択したトーンの候補を先に表示し、デフォルトの絵文字を次に保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 피부색이 아닌 경우, 제안에서 선택한 피부색을 먼저 표시하고 기본 이모지를 그다음에 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tons diferentes do padrão, as sugestões mostram primeiro o tom selecionado e mantêm o emoji padrão em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выбранных оттенков кожи, отличных от стандартного, подсказки сначала показывают эмодзи с выбранным оттенком, а затем обычный эмодзи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan dışındaki ten tonlarında öneriler önce seçtiğiniz tonu, ardından varsayılan emojiyi gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于非默认肤色，建议会先显示你选择的肤色，随后保留默认表情符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於非預設膚色，建議會先顯示你選取的膚色，接著保留預設表情符號。"
          }
        }
      }
    },
    "Forget recently and frequently used emoji so the picker ranks from scratch.": {
      "comment": "Used in: UI/Settings/Panes/EmojiPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسَ الرموز التعبيرية المستخدمة مؤخرًا وبكثرة كي يعيد المنتقي ترتيبها من الصفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt und häufig verwendete Emojis vergessen, damit die Auswahl neu sortiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida los emojis usados recientemente y con frecuencia para que el selector vuelva a ordenarlos desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l’historique des emoji récents et fréquents pour que le sélecteur les classe à nouveau depuis le début."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल में और अक्सर उपयोग किए गए इमोजी हटाएँ, ताकि पिकर नए सिरे से क्रम तय करे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lupakan emoji yang baru dan sering digunakan agar pemilih mengurutkan dari awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica le emoji usate di recente e più di frequente, così il selettore riparte da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字とよく使う絵文字を忘れ、ピッカーの順位付けを最初からやり直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 사용했거나 자주 사용한 이모지를 잊어 선택기를 처음부터 순위 매기게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer emojis usados recentemente e com frequência para que o seletor recomece a classificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить историю недавно и часто использовавшихся эмодзи, чтобы список начал ранжироваться заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçicinin sıralamayı baştan yapması için son ve sık kullanılan emojileri unut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记最近使用和常用的表情符号，让选择器从头开始排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忘記最近使用及常用的表情符號，讓選擇器從頭開始排序。"
          }
        }
      }
    },
