        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 모델 요청의 타이밍을 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar o tempo de cada solicitação ao modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать время каждого запроса модели."
