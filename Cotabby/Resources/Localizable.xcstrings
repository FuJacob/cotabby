    "Performance tracking is off. Enable the toggle above to start recording requests.": {
      "comment": "Used in: UI/Settings/Panes/PerformancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الأداء متوقف. فعّل المفتاح أعلاه لبدء تسجيل الطلبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leistungserfassung ist deaktiviert. Aktiviere den Schalter oben, um Anfragen aufzuzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento del rendimiento está desactivado. Activa el control de arriba para empezar a registrar solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi des performances est désactivé. Activez le réglage ci-dessus pour commencer à enregistrer les requêtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदर्शन ट्रैकिंग बंद है। अनुरोध रिकॉर्ड करना शुरू करने के लिए ऊपर का टॉगल सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelacakan performa nonaktif. Aktifkan sakelar di atas untuk mulai merekam permintaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il monitoraggio delle prestazioni è disattivato. Attiva l’opzione qui sopra per iniziare a registrare le richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パフォーマンス追跡はオフです。上の切り替えを有効にするとリクエストの記録が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성능 추적이 꺼져 있습니다. 요청 기록을 시작하려면 위 토글을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O monitoramento de desempenho está desativado. Ative o controle acima para começar a registrar solicitações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись показателей производительности выключена. Включите переключатель выше, чтобы начать записывать запросы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Performans takibi kapalı. İstekleri kaydetmeye başlamak için yukarıdaki anahtarı açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性能跟踪已关闭。启用上方开关即可开始记录请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "效能追蹤已關閉。請啟用上方的切換項目以開始記錄要求。"
          }
        }
      }
    },
