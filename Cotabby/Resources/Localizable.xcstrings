    "Typing history couldn't be opened, so it's paused to avoid overwriting it.": {
      "comment": "Used in: Services/History/TypingHistoryStore.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح سجل الكتابة، لذا أُوقف مؤقتًا لتجنب الكتابة فوقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibverlauf konnte nicht geöffnet werden und wurde pausiert, um ein Überschreiben zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el historial de escritura, así que se pausó para evitar sobrescribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique de saisie n’a pas pu être ouvert ; il est donc en pause pour éviter de l’écraser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइपिंग इतिहास खोला नहीं जा सका, इसलिए उसे ओवरराइट होने से बचाने के लिए रिकॉर्डिंग रोक दी गई है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat ketikan tidak dapat dibuka, jadi dijeda agar tidak tertimpa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cronologia di digitazione, quindi è stata messa in pausa per evitare di sovrascriverla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
