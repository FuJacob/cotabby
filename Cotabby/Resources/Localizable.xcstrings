    "Connect to load models, or enter an identifier manually.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+Actions.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل لتحميل النماذج، أو أدخل معرّفًا يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Laden von Modellen verbinden oder eine Kennung manuell eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate para cargar modelos o introduce un identificador manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter pour charger les modèles ou saisir un identifiant manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल लोड करने के लिए कनेक्ट करें या पहचानकर्ता मैन्युअल रूप से दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan untuk memuat model, atau masukkan pengenal secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti per caricare i modelli o inserisci manualmente un identificatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを読み込むには接続するか、識別子を手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 불러오려면 연결하거나 식별자를 직접 입력합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se para carregar modelos ou digite um identificador manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь, чтобы загрузить модели, или введите идентификатор вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleri yüklemek için bağlanın veya bir tanımlayıcıyı elle girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接以加载模型，或手动输入标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線以載入模型，或手動輸入識別碼。"
          }
        }
      }
    },
