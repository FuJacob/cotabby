    "Jump straight to the controls you reach for most.": {
      "comment": "Used in: UI/Settings/Panes/HomePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل مباشرة إلى عناصر التحكم التي تستخدمها أكثر من غيرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt zu den am häufigsten verwendeten Steuerelementen springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve directamente a los controles que más utilizas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accéder directement aux commandes que vous utilisez le plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सबसे अधिक इस्तेमाल करने वाले नियंत्रणों पर सीधे जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung menuju kontrol yang paling sering Anda gunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai direttamente ai controlli che usi più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うコントロールにすぐ移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하는 컨트롤로 바로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá direto aos controles que você mais usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу переходите к элементам управления, которыми пользуетесь чаще всего."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
