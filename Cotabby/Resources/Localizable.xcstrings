          "stringUnit": {
            "state": "translated",
            "value": "すべての候補と一緒に送信する用語集またはメモ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 제안과 함께 전송되는 용어집 또는 메모."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Glossário ou notas que acompanham cada sugestão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глоссарий или заметки, отправляемые с каждой подсказкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her öneriyle gönderilen sözlük veya notlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随每条建议发送的术语表或备注。"
