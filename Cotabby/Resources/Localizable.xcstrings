    "Start Cotabby automatically when you log in to your Mac.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء Cotabby تلقائيًا عند تسجيل الدخول إلى جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby automatisch starten, wenn du dich an deinem Mac anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Cotabby automáticamente cuando inicies sesión en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer Cotabby automatiquement à l’ouverture de session sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac में लॉगिन करने पर Cotabby अपने आप शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Cotabby otomatis saat Anda login ke Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Cotabby automaticamente quando accedi al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacにログインしたときCotabbyを自動的に起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인할 때 Cotabby를 자동으로 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar o Cotabby automaticamente quando você iniciar sessão no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать Cotabby автоматически при входе в систему на Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inize giriş yaptığınızda Cotabby'yi otomatik olarak başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Mac 时自动启动 Cotabby。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 Mac 時自動啟動 Cotabby。"
          }
        }
      }
    },
