    "Public endpoints must use HTTPS. HTTP is limited to this Mac or the local network.": {
      "comment": "Used in: Models/Runtime/OpenAICompatibleEndpointModels.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تستخدم نقاط النهاية العامة HTTPS. يقتصر HTTP على جهاز Mac هذا أو الشبكة المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliche Endpunkte müssen HTTPS verwenden. HTTP ist auf diesen Mac oder das lokale Netzwerk beschränkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los endpoints públicos deben usar HTTPS. HTTP se limita a este Mac o a la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les endpoints publics doivent utiliser HTTPS. HTTP est limité à ce Mac ou au réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक एंडपॉइंट को HTTPS का उपयोग करना चाहिए। HTTP इस Mac या स्थानीय नेटवर्क तक सीमित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint publik harus menggunakan HTTPS. HTTP dibatasi untuk Mac ini atau jaringan lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli endpoint pubblici devono usare HTTPS. HTTP è limitato a questo Mac o alla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開エンドポイントではHTTPSが必要です。HTTPはこのMacまたはローカルネットワークに限定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 엔드포인트는 HTTPS를 사용해야 합니다. HTTP는 이 Mac 또는 로컬 네트워크로 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoints públicos devem usar HTTPS. HTTP é limitado a este Mac ou à rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общедоступные эндпоинты должны использовать HTTPS. HTTP разрешён только для этого Mac или локальной сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel uç noktalar HTTPS kullanmalıdır. HTTP bu Mac veya yerel ağla sınırlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共端点必须使用 HTTPS。HTTP 仅限此 Mac 或本地网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開端點必須使用 HTTPS。HTTP 僅限此 Mac 或區域網路使用。"
          }
        }
      }
    },
