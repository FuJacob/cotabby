    "Capped at %lld characters. Anything pasted beyond that is trimmed automatically.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى %lld حرفًا. تُقص تلقائيًا أي بيانات ملصقة تتجاوز ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt auf %lld Zeichen. Alles, was darüber hinaus eingefügt wird, wird automatisch gekürzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de %lld caracteres. Todo lo pegado después se recorta automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limité à %lld caractères. Tout ce qui est collé au-delà est automatiquement tronqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा %lld वर्णों पर है। इसके आगे चिपकाया गया सब कुछ अपने आप छोटा कर दिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibatasi hingga %lld karakter. Apa pun yang ditempel melebihi batas akan dipangkas otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di %lld caratteri. Tutto ciò che viene incollato oltre il limite viene tagliato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限は%lld文字です。上限を超えた部分は自動的に切り詰められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld자입니다. 그보다 많이 붙여넣은 내용은 자동으로 잘립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de %lld caracteres. Qualquer conteúdo colado além disso é cortado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение: %lld символов. Всё вставленное сверх этого автоматически обрезается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld karakterle sınırlı. Bunun ötesine yapıştırılan her şey otomatik olarak kırpılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限为 %lld 个字符。超出部分会自动截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限為 %lld 個字元。超過上限的貼上內容會自動截短。"
          }
        }
      }
    },
