    "Restore every Cotabby setting to its original default.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة كل إعدادات Cotabby إلى قيمتها الافتراضية الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Cotabby-Einstellungen auf ihren ursprünglichen Standard zurücksetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos los ajustes de Cotabby a sus valores predeterminados originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir chaque réglage de Cotabby à sa valeur par défaut d’origine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby की हर सेटिंग को उसके मूल डिफ़ॉल्ट पर पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan semua pengaturan Cotabby ke nilai bawaan semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina ogni impostazione di Cotabby al valore predefinito originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyのすべての設定を元のデフォルトに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Cotabby 설정을 원래 기본값으로 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar todos os ajustes do Cotabby para o padrão original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить исходные значения всех настроек Cotabby."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Cotabby ayarını ilk varsayılanına geri yükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Cotabby 的所有设置恢复为原始默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有 Cotabby 設定還原為原始預設值。"
          }
        }
      }
    },
    "Restore every Cotabby setting to its original default. This does not change macOS permissions, your Open at Login choice, or your accepted-word count.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة كل إعدادات Cotabby إلى قيمتها الافتراضية الأصلية. لا يغيّر ذلك أذونات macOS أو اختيارك للفتح عند تسجيل الدخول أو عدد الكلمات المقبولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Cotabby-Einstellungen auf ihren ursprünglichen Standard zurücksetzen. Dies ändert weder macOS-Berechtigungen noch deine Einstellung für „Beim Anmelden öffnen“ oder die Anzahl deiner übernommenen Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos los ajustes de Cotabby a sus valores predeterminados originales. Esto no cambia los permisos de macOS, la opción Abrir al iniciar sesión ni el recuento de palabras aceptadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir chaque réglage de Cotabby à sa valeur par défaut d’origine. Cela ne modifie pas les autorisations macOS, le réglage d’ouverture de Cotabby à l’ouverture de session ni votre compteur de mots acceptés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby की हर सेटिंग को उसके मूल डिफ़ॉल्ट पर पुनर्स्थापित करें। इससे macOS अनुमतियाँ, आपकी Open at Login पसंद या स्वीकार किए गए शब्दों की गिनती नहीं बदलती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan semua pengaturan Cotabby ke nilai bawaan semula. Ini tidak mengubah izin macOS, pilihan Buka saat Login, atau jumlah kata yang diterima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina ogni impostazione di Cotabby al valore predefinito originale. Questa operazione non modifica le autorizzazioni di macOS, l’impostazione “Apri al login” o il conteggio delle parole accettate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyのすべての設定を元のデフォルトに戻します。macOSの権限、ログイン時に開く設定、挿入した単語数は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Cotabby 설정을 원래 기본값으로 복원합니다. macOS 권한, 로그인 시 열기 선택 또는 수락한 단어 수는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar todos os ajustes do Cotabby para o padrão original. Isso não altera as permissões do macOS, sua escolha de abrir ao iniciar sessão nem sua contagem de palavras aceitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить исходные значения всех настроек Cotabby. Это не изменит разрешения macOS, выбор «Открывать при входе» и счётчик принятых слов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Cotabby ayarını ilk varsayılanına geri yükleyin. Bu işlem macOS izinlerini, Girişte Aç seçiminizi veya kabul edilen kelime sayınızı değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Cotabby 的所有设置恢复为原始默认值。不会更改 macOS 权限、“登录时打开”选择或已插入单词数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有 Cotabby 設定還原為原始預設值。這不會變更 macOS 權限、「登入時開啟」選擇或已接受的單字計數。"
          }
        }
      }
    },
