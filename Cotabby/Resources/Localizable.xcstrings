          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) %@에서 수행할 키가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tecla executará %@ em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна клавиша не выполняет %@ в %@."
