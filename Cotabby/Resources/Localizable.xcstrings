    "Apple Intelligence does not support the current language or locale for this request.": {
      "comment": "Used in: Services/Runtime/AppleIntelligence/FoundationModelSuggestionEngine.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم Apple Intelligence اللغة أو الإعدادات المحلية الحالية لهذا الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence unterstützt die aktuelle Sprache oder Region für diese Anfrage nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no admite el idioma o la configuración regional actual para esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne prend pas en charge la langue ou les paramètres régionaux actuels pour cette requête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence इस अनुरोध की मौजूदा भाषा या लोकेल का समर्थन नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tidak mendukung bahasa atau lokal saat ini untuk permintaan ini."
          }
        },
        "it": {
          "stringUnit": {
