    "Use the local model for languages Apple Intelligence doesn't support.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام النموذج المحلي للغات التي لا يدعمها Apple Intelligence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Modell für Sprachen verwenden, die Apple Intelligence nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el modelo local para los idiomas que Apple Intelligence no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le modèle local pour les langues qu’Apple Intelligence ne prend pas en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence द्वारा समर्थित न होने वाली भाषाओं के लिए स्थानीय मॉडल उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan model lokal untuk bahasa yang tidak didukung Apple Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il modello locale per le lingue non supportate da Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceが対応していない言語にはローカルモデルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 지원하지 않는 언어에 로컬 모델 사용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o modelo local para idiomas que o Apple Intelligence não oferece suporte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать локальную модель для языков, которые не поддерживает Apple Intelligence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence'ın desteklemediği diller için yerel modeli kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于 Apple Intelligence 不支持的语言，使用本地模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於 Apple Intelligence 不支援的語言，使用本機模型。"
          }
        }
      }
    },
    "Uses a %@ model, which may run slowly on this Mac.": {
      "comment": "Used in: Support/Onboarding/OnboardingTemplateRecommender.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم نموذج %@، وقد يعمل ببطء على جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet ein %@-Modell, das auf diesem Mac möglicherweise langsam läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un modelo %@, que podría funcionar lentamente en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un modèle %@, qui peut être lent sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ मॉडल उपयोग करता है, जो इस Mac पर धीमा चल सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan model %@, yang mungkin berjalan lambat di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un modello %@, che potrebbe funzionare lentamente su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@モデルを使用します。このMacでは遅くなる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 모델을 사용하며 이 Mac에서 느리게 실행될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa um modelo %@, que pode ser lento neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется модель %@, которая может работать медленно на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çalışabilecek %@ modelini kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
