    "Set automatically by power source. Turn off power-based switching in the Power section to choose it here.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+AppleIntelligence.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدّد تلقائيًا حسب مصدر الطاقة. أوقف التبديل حسب الطاقة في قسم الطاقة لاختياره هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch anhand der Stromquelle festgelegt. Deaktiviere den automatischen Wechsel je nach Stromquelle im Bereich „Energie“, um die Auswahl hier zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de alimentación lo establece automáticamente. Desactiva el cambio según la alimentación en la sección Energía para elegirlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini automatiquement par la source d’alimentation. Désactivez la bascule selon l’alimentation dans la section Alimentation pour le choisir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर स्रोत के अनुसार अपने आप सेट होता है। इसे यहाँ चुनने के लिए Power सेक्शन में पावर-आधारित स्विचिंग बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diatur otomatis berdasarkan sumber daya. Matikan peralihan berdasarkan daya di bagian Daya untuk memilihnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostato automaticamente dalla fonte di alimentazione. Disattiva il cambio basato sull'alimentazione nella sezione Alimentazione per sceglierlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に応じて自動設定されます。電源による切り替えをオフにするには「電源」セクションを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 소스에 따라 자동 설정됩니다. 여기에서 선택하려면 전원 섹션에서 전원 기반 전환을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido automaticamente pela fonte de energia. Desative a troca baseada na energia na seção Energia para escolhê-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливается автоматически источником питания. Отключите переключение по питанию в разделе «Питание», чтобы выбрать его здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç kaynağı tarafından otomatik olarak ayarlanır. Burada seçmek için Güç bölümünde güce dayalı geçişi kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电源自动设置。若要在此处选择，请在“电源”部分关闭基于电源的切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由電源自動設定。若要在此選擇，請在「電源」區段關閉依電源切換。"
          }
        }
      }
    },
    "Set automatically by power source. Use the On Battery / Plugged In pickers in the Power section, or turn off power-based switching.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+OpenSource.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدّد تلقائيًا حسب مصدر الطاقة. استخدم خياري «على البطارية» و«موصول بالطاقة» في قسم الطاقة، أو أوقف التبديل حسب مصدر الطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch anhand der Stromquelle festgelegt. Verwende die Auswahlfelder „Batteriebetrieb“ / „Netzbetrieb“ im Bereich „Energie“ oder deaktiviere den automatischen Wechsel je nach Stromquelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de alimentación lo establece automáticamente. Usa los selectores Con batería / Conectado a la corriente de la sección Energía o desactiva el cambio según la alimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini automatiquement par la source d’alimentation. Utilisez les sélecteurs Sur batterie / Sur secteur dans la section Alimentation, ou désactivez la bascule selon l’alimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर स्रोत के अनुसार अपने आप सेट होता है। Power सेक्शन में On Battery / Plugged In पिकर उपयोग करें या पावर-आधारित स्विचिंग बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diatur otomatis berdasarkan sumber daya. Gunakan pemilih Dengan Baterai / Tersambung ke Daya di bagian Daya, atau matikan peralihan berdasarkan daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostato automaticamente dalla fonte di alimentazione. Usa i selettori A batteria / Collegato all'alimentazione nella sezione Alimentazione oppure disattiva il cambio basato sull'alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に応じて自動設定されます。「電源」セクションの「バッテリー使用時」／「電源接続時」選択欄を使うか、電源による切り替えをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 소스에 따라 자동 설정됩니다. 전원 섹션에서 배터리 사용 중/전원 연결됨 선택기를 사용하거나 전원 기반 전환을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido automaticamente pela fonte de energia. Use os seletores Na bateria / Conectado à tomada na seção Energia ou desative a troca baseada na energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливается автоматически источником питания. Используйте варианты «От аккумулятора» и «При подключённом питании» в разделе «Питание» или отключите переключение по питанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç kaynağı tarafından otomatik olarak ayarlanır. Güç bölümünde Pilde / Prize Takılı seçicilerini kullanın veya güce dayalı geçişi kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电源自动设置。请使用“电源”部分中的“使用电池/已接通电源”选择器，或关闭基于电源的切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由電源自動設定。請使用「電源」區段中的「使用電池／接上電源」選擇器，或關閉依電源切換。"
          }
        }
      }
    },
