    "Suggestions never render above this size. Lower it if ghost text ever appears oversized.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتجاوز حجم عرض الاقتراحات هذا الحد مطلقًا. خفّضه إذا ظهر النص الوهمي أكبر من اللازم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge werden nie über dieser Größe angezeigt. Verringere sie, wenn der Geistertext zu groß erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias nunca se muestran por encima de este tamaño. Redúcelo si el texto fantasma aparece demasiado grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions ne s’affichent jamais au-dessus de cette taille. Réduisez-la si le texte fantôme paraît trop grand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव इस आकार से बड़े कभी नहीं दिखेंगे। घोस्ट टेक्स्ट कभी बहुत बड़ा दिखे तो इसे कम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saran tidak pernah ditampilkan di atas ukuran ini. Kurangi jika teks ghost terlihat terlalu besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti non vengono mai visualizzati oltre questa dimensione. Riducila se il testo fantasma appare sovradimensionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補はこのサイズを超えて表示されません。ゴーストテキストが大きすぎる場合は小さくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안은 이 크기보다 크게 표시되지 않습니다. 고스트 텍스트가 너무 크게 나타나면 낮추세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões nunca são exibidas acima deste tamanho. Reduza-o se o texto fantasma aparecer grande demais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки никогда не отображаются крупнее этого размера. Уменьшите его, если призрачный текст иногда выглядит слишком большим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneriler hiçbir zaman bu boyutun üzerinde görüntülenmez. Hayalet metin çok büyük görünürse azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议显示不会超过此大小。如果幽灵文本看起来过大，请调低此值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議不會以大於此值的大小顯示。如果幽靈文字看起來過大，請調低此值。"
          }
        }
      }
    },
    "Suggestions never render below this size, even in fields that report tiny text.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُعرض الاقتراحات أبدًا بأصغر من هذا الحجم، حتى في الحقول التي تُبلغ عن نص صغير جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge werden nie unter dieser Größe angezeigt, auch nicht in Feldern, die winzigen Text melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias nunca se muestran por debajo de este tamaño, ni siquiera en campos que indican un texto diminuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions ne s’affichent jamais en dessous de cette taille, même dans les champs qui signalent un texte minuscule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव इस आकार से छोटे कभी नहीं दिखेंगे, यहाँ तक कि बहुत छोटे टेक्स्ट की रिपोर्ट करने वाले फ़ील्ड में भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saran tidak pernah ditampilkan di bawah ukuran ini, bahkan di bidang yang melaporkan teks sangat kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti non vengono mai visualizzati sotto questa dimensione, anche nei campi che indicano un testo molto piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが小さいと報告する入力欄でも、候補はこのサイズ未満で表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 아주 작다고 보고하는 필드에서도 제안은 이 크기보다 작게 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões nunca são exibidas abaixo deste tamanho, mesmo em campos que informam texto muito pequeno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки никогда не отображаются мельче этого размера, даже в полях, сообщающих о маленьком тексте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin boyutunu çok küçük bildiren alanlarda bile öneriler bu boyutun altında görüntülenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议显示不会低于此大小，即使输入框报告的文本很小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使輸入欄位回報的文字很小，建議也不會以小於此值的大小顯示。"
          }
        }
      }
    },
