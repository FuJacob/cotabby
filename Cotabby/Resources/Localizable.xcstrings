    "Your name and languages are passed to the AI to help personalize your completions.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل اسمك ولغاتك إلى الذكاء الاصطناعي للمساعدة في تخصيص إكمالاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name und deine Sprachen werden an die KI übermittelt, damit sie deine Vorschläge personalisieren kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre e idiomas se envían a la IA para ayudar a personalizar tus finalizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom et les langues choisies sont transmis à l’IA pour personnaliser vos suggestions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नाम और भाषाएँ वैयक्तिकृत सुझाव देने में AI की मदद के लिए उसे भेजे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan bahasa Anda disertakan dalam konteks AI untuk membantu mempersonalisasi pelengkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome e le tue lingue vengono passati all'IA per personalizzare i completamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と言語をAIに渡して、候補をあなた向けに調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 완성 결과를 개인화하기 위해 이름과 언어가 AI에 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome e seus idiomas são enviados à IA para ajudar a personalizar suas sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя и языки передаются ИИ, чтобы персонализировать ваши автодополнения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız ve dilleriniz, tamamlamaları kişiselleştirmeye yardımcı olması için yapay zekâya gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字和语言会传递给 AI，以帮助个性化你的补全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字與語言會傳送給 AI，協助個人化你的自動完成建議。"
          }
        }
      }
    },
