    "The Apple on-device model rejected the prompt because it was too large.": {
      "comment": "Used in: Services/Runtime/AppleIntelligence/FoundationModelSuggestionEngine.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض النموذج الموجود على الجهاز من Apple المطالبة لأنها كبيرة جدًا."
          }
        },
        "de": {
          "stringUnit": {
