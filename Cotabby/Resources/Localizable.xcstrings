    "Subordinate to Cotabby's base autocomplete rules, so it cannot override core behavior.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع لقواعد الإكمال التلقائي الأساسية في Cotabby، لذلك لا يمكنه تجاوز السلوك الأساسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterliegt Cotabbys grundlegenden Regeln für automatische Vervollständigung und kann deren Kernverhalten nicht überschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está subordinado a las reglas de autocompletado base de Cotabby, por lo que no puede anular el comportamiento principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Subordonné aux règles d’autocomplétion de base de Cotabby, il ne peut donc pas remplacer le comportement principal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby के बेस ऑटोकम्प्लीट नियमों के अधीन, इसलिए यह मुख्य व्यवहार को ओवरराइड नहीं कर सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunduk pada aturan dasar pelengkapan otomatis Cotabby, sehingga tidak dapat mengubah perilaku inti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È subordinata alle regole di completamento automatico di base di Cotabby e non può quindi sovrascriverne il comportamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyの基本自動補完ルールに従うため、中心的な動作を上書きできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby의 기본 자동 완성 규칙보다 우선할 수 없으므로 핵심 동작을 바꿀 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subordinado às regras básicas de preenchimento automático do Cotabby, portanto não pode substituir o comportamento principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подчиняется базовым правилам автодополнения Cotabby и поэтому не может переопределить основное поведение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby'nin temel otomatik tamamlama kurallarına bağlıdır; bu nedenle temel davranışı geçersiz kılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从属于 Cotabby 的基础自动补全规则，因此无法覆盖核心行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受 Cotabby 基本自動完成規則約束，因此無法覆寫核心行為。"
          }
        }
      }
    },
