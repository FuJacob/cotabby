        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tombol yang akan melakukan %@ di %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasto eseguirà %@ in %@."
          }
        },
        "ja": {
