    "Try “color”, “shortcut”, “battery”, or “privacy”.": {
      "comment": "Used in: UI/Settings/Panes/HomePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب «اللون» أو «الاختصار» أو «البطارية» أو «الخصوصية»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche „Farbe“, „Kurzbefehl“, „Batterie“ oder „Datenschutz“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba «color», «atajo», «batería» o «privacidad»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez « couleur », « raccourci », « batterie » ou « confidentialité »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“रंग”, “शॉर्टकट”, “बैटरी” या “निजता” आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba “warna”, “pintasan”, “baterai”, atau “privasi”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova “colore”, “scorciatoia”, “batteria” o “privacy”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「color」「shortcut」「battery」「privacy」を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“색상”, “단축키”, “배터리”, “개인정보 보호”를 검색해 보세요."
          }
        },
        "pt-BR": {
