          }
        }
      }
    },
    "Whether the local model is loaded and ready to generate. Loading takes a few seconds the first time.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+OpenSource.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما إذا كان النموذج المحلي محمّلًا وجاهزًا للتوليد. يستغرق التحميل بضع ثوانٍ في المرة الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob das lokale Modell geladen und zum Generieren bereit ist. Beim ersten Mal dauert das Laden einige Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el modelo local está cargado y listo para generar. La primera carga tarda unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si le modèle local est chargé et prêt à générer. Le premier chargement prend quelques secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय मॉडल लोड होकर जनरेट करने के लिए तैयार है या नहीं। पहली बार लोड होने में कुछ सेकंड लगते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah model lokal dimuat dan siap membuat saran. Pemuatan pertama memerlukan beberapa detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il modello locale è caricato e pronto a generare. Il primo caricamento richiede alcuni secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルが読み込まれ、生成できる状態かどうか。初回の読み込みには数秒かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델이 로드되어 생성할 준비가 되었는지 여부입니다. 처음에는 로드하는 데 몇 초가 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o modelo local está carregado e pronto para gerar. O carregamento leva alguns segundos na primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружена ли локальная модель и готова ли она к генерации. При первой загрузке требуется несколько секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel modelin yüklü ve içerik oluşturmaya hazır olup olmadığını gösterir. İlk yükleme birkaç saniye sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型是否已加载并准备生成。首次加载需要几秒钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機模型是否已載入並準備生成。第一次載入需幾秒鐘。"
          }
        }
      }
    },
