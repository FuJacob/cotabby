        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pintasan per app. Cotabby menggunakan tombol penerimaan global di mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scorciatoia specifica per app. Cotabby usa ovunque il tasto globale di accettazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとのショートカットはありません。Cotabbyはどこでもグローバルの候補挿入キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 단축키가 없습니다. Cotabby는 어디서나 전역 수락 키를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum atalho por app. O Cotabby usa a tecla de aceitação global em todos os lugares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетаний для отдельных приложений нет. Cotabby использует глобальную клавишу принятия везде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama başına kısayol yok. Cotabby her yerde genel kabul tuşunu kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有按 App 设置的快捷键。Cotabby 在所有位置使用同一个全局建议插入快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 App 專屬快速鍵。Cotabby 在所有地方都使用全域接受按鍵。"
          }
        }
      }
    },
    "No requests recorded yet. Trigger a suggestion to start populating this list.": {
