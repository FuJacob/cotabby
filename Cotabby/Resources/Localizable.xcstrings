    "Optional bearer token stored in Keychain. Ollama does not require one.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+Endpoint.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز وصول اختياري من نوع Bearer يُخزّن في سلسلة المفاتيح. لا يتطلب Ollama رمزًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionales Bearer-Token, sicher im Schlüsselbund gespeichert. Ollama benötigt keines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Bearer opcional guardado en el Llavero. Ollama no requiere uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton bearer facultatif stocké dans le trousseau. Ollama n’en nécessite pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक bearer token Keychain में संग्रहीत। Ollama को इसकी आवश्यकता नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token bearer opsional yang disimpan di Keychain. Ollama tidak memerlukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Bearer facoltativo, memorizzato nel Portachiavi. Ollama non ne richiede uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychainに保存される任意のベアラートークン。Ollamaには不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에 저장되는 선택적 bearer 토큰입니다. Ollama에는 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token bearer opcional armazenado no Acesso às Chaves. O Ollama não exige um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательный токен Bearer хранится в Связке ключей. Для Ollama такой токен не нужен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain'de saklanan isteğe bağlı bearer token. Ollama için gerekli değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在钥匙串中的可选 Bearer 令牌。Ollama 不需要令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用的 Bearer 權杖會儲存在鑰匙圈中。Ollama 不需要此權杖。"
          }
        }
      }
    },
