    "Type / for dates, math, units, currency, and randoms.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب / للتواريخ والحساب وتحويل الوحدات والعملات والقيم العشوائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib / für Datum, Mathematik, Einheiten, Währung und Zufallswerte ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe / para usar fechas, cálculos, conversiones de unidades y moneda, y valores aleatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez / pour insérer des dates, effectuer des calculs, convertir des unités ou des devises et générer des nombres aléatoires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीख, गणित, इकाई, मुद्रा और रैंडम के लिए / टाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik / untuk tanggal, matematika, satuan, mata uang, dan acak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita / per date, calcoli, unità, valute e valori casuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、計算、単位、通貨、ランダム値には / を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜, 계산, 단위, 통화 및 난수 기능을 사용하려면 /를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite / para datas, matemática, unidades, moeda e aleatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите / для работы с датами, вычислениями, единицами измерения, валютой и случайными числами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih, matematik, birim, para birimi ve rastgele değerler için / yazın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 / 可使用日期、数学、单位、货币和随机数宏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 / 以使用日期、數學、單位、貨幣與隨機功能。"
          }
        }
      }
    },
    "Type / then a macro: dates (today, tmrw, next-fri), math (5+5=), units (10km to mi), currency ($100 to eur), or random (dice, random(1,6)). Then press your accept-word shortcut to insert the result.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب / ثم وحدة ماكرو: للتواريخ (today وtmrw وnext-fri)، والحساب (5+5=)، والوحدات (10km to mi)، والعملات ($100 to eur)، أو العشوائيات (dice وrandom(1,6)). ثم اضغط اختصار قبول الكلمة لإدراج النتيجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib / und dann ein Makro ein: Datum (today, tmrw, next-fri), Mathematik (5+5=), Einheiten (10km to mi), Währung ($100 to eur) oder Zufall (dice, random(1,6)). Drücke dann deinen Kurzbefehl zum Übernehmen eines Wortes, um das Ergebnis einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe / y después una macro: fechas (today, tmrw, next-fri), cálculos (5+5=), unidades (10km to mi), moneda ($100 to eur) o valores aleatorios (dice, random(1,6)). Después pulsa el atajo de aceptar palabra para insertar el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez / puis une macro : dates (today, tmrw, next-fri), calculs (5+5=), unités (10km to mi), conversions de devises ($100 to eur) ou nombres aléatoires (dice, random(1,6)). Appuyez ensuite sur votre raccourci « Accepter le mot » pour insérer le résultat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "/ टाइप करें, फिर मैक्रो: तारीखें (today, tmrw, next-fri), गणित (5+5=), इकाइयाँ (10km to mi), मुद्रा ($100 to eur) या रैंडम (dice, random(1,6))। फिर परिणाम डालने के लिए अपना स्वीकार-शब्द शॉर्टकट दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik / lalu sebuah makro: tanggal (today, tmrw, next-fri), matematika (5+5=), satuan (10km to mi), mata uang ($100 to eur), atau acak (dice, random(1,6)). Lalu tekan pintasan terima-kata untuk menyisipkan hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita / seguito da una macro: date (today, tmrw, next-fri), calcoli (5+5=), unità (10km to mi), valuta ($100 to eur) o casuale (dice, random(1,6)). Poi premi la scorciatoia per accettare la parola e inserire il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず / を入力してマクロを続けます：日付（today、tmrw、next-fri）、計算（5+5=）、単位（10km to mi）、通貨（$100 to eur）、ランダム（dice、random(1,6)）。次に単語挿入ショートカットを押して結果を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/를 입력한 다음 매크로를 입력합니다: 날짜(today, tmrw, next-fri), 계산(5+5=), 단위(10km to mi), 통화($100 to eur) 또는 난수(dice, random(1,6)). 그런 다음 단어 수락 단축키를 눌러 결과를 삽입합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite / e depois uma macro: datas (today, tmrw, next-fri), matemática (5+5=), unidades (10km to mi), moeda ($100 to eur) ou aleatório (dice, random(1,6)). Depois, pressione o atalho de aceitar palavra para inserir o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите /, затем макрос: даты (today, tmrw, next-fri), математика (5+5=), единицы (10km to mi), валюта ($100 to eur) или случайное (dice, random(1,6)). Затем нажмите сочетание для принятия слова, чтобы вставить результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce /, ardından bir makro yazın: tarih (today, tmrw, next-fri), matematik (5+5=), birim (10km to mi), para birimi ($100 to eur) veya rastgele (dice, random(1,6)). Sonucu eklemek için kelime kabul kısayolunuza basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 /，然后输入宏：日期（today、tmrw、next-fri）、数学（5+5=）、单位（10km to mi）、货币（$100 to eur）或随机数（dice、random(1,6)）。然后按插入单词快捷键插入结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 /，接著輸入巨集：日期（today、tmrw、next-fri）、數學（5+5=）、單位（10km to mi）、貨幣（$100 to eur）或隨機（dice、random(1,6)）。接著按下接受單字快速鍵以插入結果。"
          }
        }
      }
    },
