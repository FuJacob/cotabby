    "Where downloaded model files are stored on this Mac.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+OpenSource.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان تخزين ملفات النماذج التي تم تنزيلها على جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
