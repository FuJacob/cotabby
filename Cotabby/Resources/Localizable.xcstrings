    "Show caret and field outlines, focus polling, and screen-context status. Changes apply immediately.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار حدود موضع الإدراج والحقل، ومعلومات استطلاع التركيز، وحالة سياق الشاشة. تُطبّق التغييرات فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umrisse der Einfügemarke und des Feldes, Fokusabfragen und Status des Bildschirmkontexts anzeigen. Änderungen werden sofort angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los contornos del cursor y del campo, el sondeo del foco y el estado del contexto de pantalla. Los cambios se aplican de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le curseur, les contours du champ, la vérification périodique du focus et l’état du contexte à l’écran. Les changements s’appliquent immédiatement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरेट और फ़ील्ड की रूपरेखा, फ़ोकस पोलिंग और स्क्रीन-संदर्भ स्थिति दिखाएँ। बदलाव तुरंत लागू होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan garis besar kursor dan bidang, polling fokus, serta status konteks layar. Perubahan langsung diterapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i contorni del cursore e del campo, il controllo periodico del focus e lo stato del contesto schermo. Le modifiche si applicano immediatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャレットとフィールドの枠、フォーカスのポーリング、画面コンテキストの状態を表示します。変更はすぐに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 및 필드 윤곽선, 포커스 폴링 및 화면 컨텍스트 상태를 표시합니다. 변경 사항은 즉시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar contornos do cursor e do campo, sondagem de foco e status do contexto da tela. As alterações são aplicadas imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать контуры каретки и поля, опрос фокуса и состояние контекста экрана. Изменения применяются сразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç ve alan ana hatlarını, odak yoklamasını ve ekran bağlamı durumunu gösterir. Değişiklikler hemen uygulanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示插入点和输入框轮廓、焦点轮询及屏幕上下文状态。更改会立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示插入點與輸入欄位外框、焦點輪詢及螢幕內容狀態。變更會立即套用。"
          }
        }
      }
    },
    "Show caret, field, focus polling, and screen-context debug panels.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
