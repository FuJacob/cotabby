        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 필드에 `/`를 입력한 다음 매크로를 입력합니다. Tab을 눌러 수락합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite / em qualquer campo de texto e depois a macro. Pressione Tab para aceitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите `/` в любое текстовое поле, затем макрос. Нажмите Tab, чтобы принять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir metin alanına `/` yazın, ardından makroyu yazın. Kabul etmek için Tab'a basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意文本输入框中输入 `/`，然后输入宏。按 Tab 插入结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何輸入欄位中輸入 /，接著輸入巨集。按 Tab 接受。"
          }
        }
      }
    },
    "Type a name like :smile to search inline, then press your accept-word shortcut to insert the selected emoji.": {
      "comment": "Used in: UI/Settings/Panes/EmojiPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب اسمًا مثل :smile للبحث مضمّنًا، ثم اضغط اختصار قبول الكلمة لإدراج الرمز التعبيري المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen wie :smile ein, um inline zu suchen, und drücke dann deinen Kurzbefehl zum Übernehmen eines Wortes, um das ausgewählte Emoji einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre como :smile para buscar en línea y después pulsa el atajo de aceptar palabra para insertar el emoji seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom comme :smile pour rechercher en ligne, puis appuyez sur votre raccourci d’acceptation du mot pour insérer l’emoji sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ":smile जैसा नाम टाइप करके इनलाइन खोजें, फिर चुना हुआ इमोजी डालने के लिए अपना शब्द-स्वीकार शॉर्टकट दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik nama seperti :smile untuk mencari sebaris, lalu tekan pintasan terima-kata untuk menyisipkan emoji yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita un nome come :smile per cercare in linea, poi premi la scorciatoia per accettare la parola e inserire l'emoji selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ":smileのような名前を入力してインライン検索し、単語挿入ショートカットを押して選択した絵文字を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ":smile 같은 이름을 입력해 인라인으로 검색한 다음 단어 수락 단축키를 눌러 선택한 이모지를 삽입합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome como :smile para buscar inline e pressione o atalho de aceitar palavra para inserir o emoji selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя, например :smile, чтобы выполнить поиск в строке, затем нажмите сочетание для принятия слова, чтобы вставить выбранный эмодзи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ":smile gibi bir ad yazarak satır içinde arayın, ardından seçilen emojiyi eklemek için kelime kabul kısayolunuza basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入类似 :smile 的名称进行行内搜索，然后按插入单词快捷键插入所选表情符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入像 :smile 這樣的名稱進行內嵌搜尋，接著按下接受單字快速鍵以插入選取的表情符號。"
          }
        }
      }
    },
    "Type below and Cotabby completes as you go, using the same engine and settings it uses everywhere. Press Tab to accept the gray suggestion, Esc to dismiss.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب أدناه وسيُكمل Cotabby النص أثناء كتابتك، باستخدام المحرك والإعدادات نفسيهما اللذين يستخدمهما في كل مكان. اضغط Tab لقبول الاقتراح الرمادي، وEsc لتجاهله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib unten Text ein, und Cotabby vervollständigt ihn während des Tippens mit derselben Engine und denselben Einstellungen wie überall. Drücke Tab, um den grauen Vorschlag zu übernehmen, Esc zum Verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe abajo y Cotabby completará mientras avanzas, usando el mismo motor y los mismos ajustes que en todas partes. Pulsa Tabulador para aceptar la sugerencia gris o Esc para descartarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ci-dessous et Cotabby complète au fil de votre saisie, avec le même moteur et les mêmes réglages que partout ailleurs. Appuyez sur Tab pour accepter la suggestion grise, sur Échap pour la masquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे टाइप करते जाएँ और Cotabby हर जगह वाले उसी इंजन और सेटिंग्ज़ से सुझाव पूरा करेगा। धूसर सुझाव स्वीकार करने के लिए Tab दबाएँ; उसे खारिज करने के लिए Esc दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik di bawah dan Cotabby akan melengkapi saat Anda mengetik, menggunakan engine dan pengaturan yang sama seperti di tempat lain. Tekan Tab untuk menerima saran abu-abu, Esc untuk menutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita qui sotto: Cotabby completa il testo mentre scrivi, usando ovunque lo stesso motore e le stesse impostazioni. Premi Tab per accettare il suggerimento grigio; premi Esc per ignorarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下で入力すると、Cotabbyはどこでも使うものと同じエンジンと設定で入力に合わせて補完します。Tabで灰色の候補を挿入し、Escで閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 입력하면 Cotabby가 어디서나 사용하는 것과 동일한 엔진과 설정으로 입력하는 대로 완성합니다. Tab을 눌러 회색 제안을 수락하고 Esc를 눌러 닫습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite abaixo e o Cotabby completará enquanto você escreve, usando o mesmo mecanismo e os mesmos ajustes usados em todo lugar. Pressione Tab para aceitar a sugestão cinza e Esc para dispensá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте ниже, и Cotabby будет дополнять текст по мере ввода, используя тот же движок и настройки, что и везде. Нажмите Tab, чтобы принять серую подсказку, Esc — чтобы закрыть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıya yazın; Cotabby, her yerde kullandığı aynı motor ve ayarlarla siz yazdıkça tamamlar. Gri öneriyi kabul etmek için Tab'a, kapatmak için Esc'ye basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方输入，Cotabby 会使用与其他位置相同的引擎和设置为你补全文本。按 Tab 插入灰色建议，按 Esc 隐藏建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方輸入時，Cotabby 會沿用各處相同的引擎與設定提供自動完成。按 Tab 接受灰色建議，按 Esc 關閉。"
          }
        }
      }
    },
