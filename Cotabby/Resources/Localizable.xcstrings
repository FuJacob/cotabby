    "Short, snappy completions that keep up with fast typing and stay light on resources.": {
      "comment": "Used in: Models/Onboarding/OnboardingTemplate.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمالات قصيرة وسريعة الاستجابة تواكب الكتابة السريعة وتبقى خفيفة على الموارد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze, schnelle Vervollständigungen, die mit schnellem Tippen Schritt halten und ressourcenschonend bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizaciones cortas y ágiles que siguen tu escritura rápida y consumen pocos recursos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétions courtes et rapides qui suivent une saisie accélérée tout en restant légères en ressources."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे और फुर्तीले सुझाव, जो तेज़ टाइपिंग के साथ ताल मिलाते हैं और कम संसाधन लेते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelengkapan singkat yang mengikuti ketikan cepat dan tidak banyak memakai sumber daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamenti brevi e rapidi che tengono il passo con la digitazione veloce e restano leggeri sulle risorse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速入力に追従し、リソースを抑える短く軽快な補完。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 입력을 따라가고 리소스를 적게 사용하는 짧고 빠른 자동 완성입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestões curtas e ágeis que acompanham a digitação rápida e consomem poucos recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткие, быстрые подсказки, успевающие за быстрым вводом и экономно расходующие ресурсы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı yazmaya ayak uyduran ve kaynakları az kullanan kısa, çevik tamamlamalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简短利落的补全，跟上快速输入，同时节省资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短而俐落的自動完成建議，能跟上快速輸入，資源占用也較少。"
          }
        }
      }
    },
