        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocomplétion par texte fantôme dans toutes les apps,\ngénérée entièrement sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ऐप में घोस्ट-टेक्स्ट ऑटोकम्प्लीट,\nपूरी तरह आपके Mac पर जनरेट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelengkapan otomatis dengan teks ghost di setiap app,\ndihasilkan sepenuhnya di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamento automatico con testo fantasma in ogni app,\ngenerato interamente sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリで使えるゴーストテキスト自動補完。\nすべてMac上で生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱의 고스트 텍스트 자동 완성,\nMac에서 전부 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchimento automático com texto fantasma em todos os apps,\ngerado inteiramente no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автодополнение призрачным текстом в каждом приложении,\nполностью сгенерированное на вашем Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamada hayalet metinle otomatik tamamlama;\nöneriler tamamen Mac'inizde oluşturulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个 App 中提供幽灵文本自动补全，\n完全在你的 Mac 上生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個 App 中顯示幽靈文字自動完成，\n完全在你的 Mac 上生成。"
          }
        }
      }
    },
