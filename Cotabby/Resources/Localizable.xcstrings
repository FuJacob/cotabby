    "Safe arithmetic: + - * / ^, parentheses, decimals, and trailing % (percent). Accepting inserts only the result.": {
      "comment": "Used in: UI/InlineFeatures/MacroReferenceSheet.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب آمن: + - * / ^ والأقواس والكسور العشرية وعلامة % اللاحقة (النسبة المئوية). يُدرج القبول النتيجة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Arithmetik: + - * / ^, Klammern, Dezimalzahlen und abschließendes % (Prozent). Bei der Übernahme wird nur das Ergebnis eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aritmética segura: + - * / ^, paréntesis, decimales y % final (porcentaje). Al aceptar solo se inserta el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arithmétique sûre : + - * / ^, parenthèses, décimales et % final (pourcentage). L’acceptation insère uniquement le résultat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित अंकगणित: + - * / ^, कोष्ठक, दशमलव और अंत में % (प्रतिशत)। स्वीकार करने पर केवल परिणाम डाला जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aritmetika aman: + - * / ^, tanda kurung, desimal, dan % di akhir (persen). Penerimaan hanya menyisipkan hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aritmetica sicura: + - * / ^, parentesi, decimali e segno % finale (percentuale). L'accettazione inserisce solo il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な算術演算：+ - * / ^、括弧、小数、末尾の%（パーセント）。挿入時は結果だけが入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 산술: + - * / ^, 괄호, 소수 및 뒤따르는 % (퍼센트). 수락하면 결과만 삽입합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aritmética segura: + - * / ^, parênteses, decimais e % no final (porcentagem). Aceitar insere somente o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасная арифметика: + - * / ^, скобки, десятичные числа и конечный % (процент). При принятии вставляется только результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli aritmetik: + - * / ^, parantezler, ondalıklar ve sondaki % (yüzde). Kabul işlemi yalnızca sonucu ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全算术：+ - * / ^、括号、小数和末尾的 %（百分号）。按插入键时仅插入计算结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全算術：+ - * / ^、括號、小數與結尾的 %（百分比）。接受時只插入結果。"
          }
        }
      }
    },
    "Same-quantity conversions across length, mass, temperature, and volume. Fully offline via Foundation Measurement.": {
      "comment": "Used in: UI/InlineFeatures/MacroReferenceSheet.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل وحدات الكمية نفسها للطول والكتلة ودرجة الحرارة والحجم. يعمل ذلك بلا اتصال بالكامل باستخدام Foundation Measurement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umrechnungen gleicher Größen für Länge, Masse, Temperatur und Volumen. Vollständig offline über Foundation Measurement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversiones entre cantidades equivalentes de longitud, masa, temperatura y volumen. Funcionan completamente sin conexión mediante Foundation Measurement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversions hors ligne entre unités d’une même grandeur : longueur, masse, température et volume. Elles s’appuient entièrement sur Foundation Measurement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबाई, द्रव्यमान, तापमान और आयतन की इकाइयों के बीच रूपांतरण। Foundation Measurement के ज़रिए पूरी तरह ऑफ़लाइन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversi besaran yang sama untuk panjang, massa, suhu, dan volume. Sepenuhnya offline melalui Foundation Measurement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversioni tra unità di misura per lunghezza, massa, temperatura e volume. Completamente offline tramite Foundation Measurement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さ、質量、温度、体積の同じ量どうしの変換。Foundation Measurementによる完全オフライン処理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이, 질량, 온도 및 부피 간 동일 수량 변환. Foundation Measurement를 통해 완전히 오프라인으로 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversões entre quantidades iguais de comprimento, massa, temperatura e volume. Totalmente offline via Foundation Measurement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразование единиц внутри одной категории: длина, масса, температура и объём. Полностью офлайн с использованием Foundation Measurement."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzunluk, kütle, sıcaklık ve hacim arasında aynı miktardaki dönüşümler. Foundation Measurement ile tamamen çevrimdışı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长度、质量、温度和体积之间的同类单位换算。通过 Foundation Measurement 完全离线运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援長度、質量、溫度與體積等相同物理量的單位換算。完全離線，使用 Foundation Measurement。"
          }
        }
      }
    },
    "Saves the text of fields where Cotabby is active, encrypted on this Mac. Password fields, terminals, and disabled apps are never recorded.": {
      "comment": "Used in: UI/Settings/Panes/TypingHistorySectionView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نص الحقول التي يكون Cotabby نشطًا فيها، مشفّرًا على جهاز Mac هذا. لا تُسجّل حقول كلمات المرور أو الطرفيات أو التطبيقات المعطّلة مطلقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert den Text von Feldern, in denen Cotabby aktiv ist, verschlüsselt auf diesem Mac. Passwortfelder, Terminals und deaktivierte Apps werden niemals aufgezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el texto de los campos donde Cotabby está activo, cifrado en este Mac. Nunca se registran campos de contraseña, terminales ni apps desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le texte des champs où Cotabby est actif, chiffré sur ce Mac. Les champs de mot de passe, les terminaux et les apps désactivées ne sont jamais enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ Cotabby सक्रिय है वहाँ के फ़ील्ड का टेक्स्ट इस Mac पर एन्क्रिप्ट करके सेव करता है। पासवर्ड फ़ील्ड, टर्मिनल और अक्षम ऐप्स कभी रिकॉर्ड नहीं किए जाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan teks bidang tempat Cotabby aktif, terenkripsi di Mac ini. Bidang kata sandi, terminal, dan app yang dinonaktifkan tidak pernah direkam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il testo dei campi in cui Cotabby è attivo, cifrato su questo Mac. I campi password, i terminali e le app disabilitate non vengono mai registrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyが有効な入力欄のテキストをこのMac上で暗号化して保存します。パスワード欄、ターミナル、無効なアプリは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby가 활성화된 필드의 텍스트를 이 Mac에 암호화하여 저장합니다. 암호 필드, 터미널 및 비활성화된 앱은 기록하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o texto dos campos em que o Cotabby está ativo, criptografado neste Mac. Campos de senha, terminais e apps desativados nunca são registrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет текст активных полей Cotabby в зашифрованном виде на этом Mac. Поля паролей, терминалы и отключённые приложения никогда не записываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby'nin etkin olduğu alanların metnini bu Mac'te şifreleyerek kaydeder. Parola alanları, terminaller ve devre dışı uygulamalar hiçbir zaman kaydedilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby 会保存其启用的输入框中的文本，并在此 Mac 上加密存储。密码输入框、终端和已停用 App 中的内容绝不会被记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上加密儲存 Cotabby 啟用之輸入欄位文字。密碼欄位、終端機與停用的 App 永不記錄。"
          }
        }
      }
    },
    "Scale suggestions if the ghost text looks too big or small.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كبّر أو صغّر الاقتراحات إذا بدا النص الوهمي كبيرًا جدًا أو صغيرًا جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge skalieren, wenn der Geistertext zu groß oder zu klein wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las sugerencias si el texto fantasma parece demasiado grande o pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster la taille des suggestions si le texte fantôme paraît trop grand ou trop petit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घोस्ट टेक्स्ट बहुत बड़ा या छोटा लगे तो सुझावों का आकार बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ukuran saran jika teks ghost terlihat terlalu besar atau kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona i suggerimenti se il testo fantasma sembra troppo grande o piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴーストテキストが大きすぎる、または小さすぎる場合に候補を拡大・縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고스트 텍스트가 너무 크거나 작아 보이면 제안 크기를 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar as sugestões se o texto fantasma parecer grande ou pequeno demais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабировать подсказки, если призрачный текст выглядит слишком большим или маленьким."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayalet metin çok büyük veya küçük görünüyorsa önerilerin ölçeğini ayarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果幽灵文本过大或过小，调整建议大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果幽靈文字看起來太大或太小，請調整建議大小。"
          }
        }
      }
    },
