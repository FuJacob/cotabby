    "Sent on every suggestion as reference material, not as instructions.": {
      "comment": "Used in: UI/Settings/Panes/ContextPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل مع كل اقتراح كمادة مرجعية، لا كتعليمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Vorschlag als Referenzmaterial gesendet, nicht als Anweisungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía con cada sugerencia como material de referencia, no como instrucciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé avec chaque suggestion comme référence, et non comme instructions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुझाव के साथ निर्देशों के रूप में नहीं, बल्कि संदर्भ सामग्री के रूप में भेजा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikirim bersama setiap saran sebagai bahan referensi, bukan instruksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato con ogni suggerimento come materiale di riferimento, non come istruzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての候補に参考資料として送信され、指示としては扱われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지침이 아닌 참고 자료로 모든 제안에 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado com cada sugestão como material de referência, não como instruções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляется с каждой подсказкой как справочный материал, а не как инструкции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her öneride talimat olarak değil, başvuru malzemesi olarak gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随每条建议发送，作为参考资料而非指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次建議都會傳送，作為參考資料，而非指示。"
          }
        }
      }
    },
