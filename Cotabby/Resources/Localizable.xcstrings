    "Preview the following phrase, or reveal one word at a time as you type or accept.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين العبارة التالية، أو اكشف كلمة واحدة في كل مرة أثناء الكتابة أو القبول."
          }
        },
        "de": {
          "stringUnit": {
