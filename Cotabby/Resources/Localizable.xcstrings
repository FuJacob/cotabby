    "A balance of speed and quality for everyday writing.": {
      "comment": "Used in: Models/Onboarding/OnboardingTemplate.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توازن بين السرعة والجودة للكتابة اليومية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausgewogene Mischung aus Geschwindigkeit und Qualität für den täglichen Schreiballtag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un equilibrio entre velocidad y calidad para escribir a diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un équilibre entre vitesse et qualité pour l’écriture quotidienne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़मर्रा के लेखन में गति और गुणवत्ता का संतुलन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keseimbangan kecepatan dan kualitas untuk menulis sehari-hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un equilibrio tra velocità e qualità per la scrittura quotidiana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日常の文章作成で速度と品質のバランス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상적인 글쓰기에 속도와 품질의 균형."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um equilíbrio entre velocidade e qualidade para a escrita do dia a dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс скорости и качества для повседневного письма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yazım için hız ve kalite dengesi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼顾日常写作的速度与质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兼顧日常寫作所需的速度與品質。"
          }
        }
      }
    },
