    "Pauses normal completions when a finished word looks misspelled. Turn this on to use the correction options.": {
      "comment": "Used in: UI/Settings/Panes/WritingPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الإكمالات العادية مؤقتًا عندما تبدو كلمة مكتملة خاطئة إملائيًا. فعّل هذا الخيار لاستخدام خيارات التصحيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Vervollständigungen werden pausiert, wenn ein fertig geschriebenes Wort möglicherweise falsch geschrieben ist. Aktiviere diese Option, um die Korrekturfunktionen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa las finalizaciones normales cuando una palabra terminada parece estar mal escrita. Actívala para usar las opciones de corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause les suggestions habituelles lorsqu’un mot terminé semble mal orthographié. Activez cette option pour utiliser les options de correction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा हुआ शब्द गलत वर्तनी वाला लगे तो सामान्य सुझाव रोकता है। सुधार विकल्पों का उपयोग करने के लिए इसे चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda pelengkapan normal saat kata yang selesai tampak salah eja. Aktifkan ini untuk menggunakan opsi koreksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa i completamenti normali quando una parola completata sembra contenere un errore. Attiva questa opzione per usare le correzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力済みの通常の候補を、単語がスペルミスに見えるときは一時停止します。修正候補を使うにはオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력을 마친 단어에 철자 오류가 있는 것으로 보이면 일반 자동 완성을 일시 중지합니다. 교정 옵션을 사용하려면 이 기능을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa sugestões normais quando uma palavra concluída parece escrita incorretamente. Ative para usar as opções de correção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает обычное автодополнение, если завершённое слово похоже на написанное с ошибкой. Включите этот параметр, чтобы использовать варианты исправления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan bir kelime yanlış yazılmış göründüğünde normal tamamlamaları duraklatır. Düzeltme seçeneklerini kullanmak için bunu açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的单词看起来拼写错误时暂停普通补全。打开此选项即可使用纠错选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單字輸入完成後若看起來拼錯，就會暫停一般自動完成。開啟此選項即可使用更正功能。"
          }
        }
      }
    },
