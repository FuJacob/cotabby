    "Record the timestamp, model, and elapsed time of every LLM request. Only the most recent %lld requests are retained.": {
      "comment": "Used in: UI/Settings/Panes/PerformancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الطابع الزمني والنموذج والمدة المنقضية لكل طلب LLM. لا يُحتفظ إلا بأحدث %lld من الطلبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitstempel, Modell und Dauer jeder LLM-Anfrage aufzeichnen. Nur die letzten %lld Anfragen werden behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la marca de tiempo, el modelo y el tiempo transcurrido de cada solicitud al LLM. Solo se conservan las %lld solicitudes más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l’horodatage, le modèle et la durée de chaque requête LLM. Seules les %lld requêtes les plus récentes sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर LLM अनुरोध का टाइमस्टैम्प, मॉडल और बीता समय रिकॉर्ड करें। केवल हाल के %lld अनुरोध रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat waktu, model, dan durasi setiap permintaan LLM. Hanya %lld permintaan terbaru yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la data e l’ora, il modello e il tempo trascorso di ogni richiesta LLM. Si conservano solo le richieste più recenti, fino a un massimo di %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのLLMリクエストのタイムスタンプ、モデル、経過時間を記録します。直近%lld件のみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 LLM 요청의 타임스탬프, 모델 및 경과 시간을 기록합니다. 최근 %lld개의 요청만 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar o horário, o modelo e o tempo decorrido de cada solicitação ao LLM. Somente as %lld solicitações mais recentes são mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать временную метку, модель и длительность каждого запроса LLM. Сохраняются только последние %lld запросов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her LLM isteğinin zaman damgasını, modelini ve geçen süresini kaydedin. Yalnızca en son %lld istek tutulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录每个 LLM 请求的时间戳、模型和耗时。仅保留最近 %lld 个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄每次 LLM 要求的時間戳記、模型與耗時。只保留最近 %lld 筆要求。"
          }
        }
      }
    },
    "Record timing for every model request.": {
      "comment": "Used in: UI/Settings/SettingsIndex.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل التوقيت لكل طلب نموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit für jede Modellanfrage aufzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el tiempo de cada solicitud al modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer la durée de chaque requête de modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मॉडल अनुरोध का समय रिकॉर्ड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam waktu untuk setiap permintaan model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la durata di ogni richiesta del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのモデルリクエストの時間を記録します。"
