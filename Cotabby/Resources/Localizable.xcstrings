          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps desactivadas. Cotabby está activo en todos los campos compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app n’est désactivée. Cotabby est actif dans tous les champs pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऐप अक्षम नहीं है। Cotabby हर समर्थित फ़ील्ड में सक्रिय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada app yang dinonaktifkan. Cotabby aktif di setiap bidang yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app disabilitata. Cotabby è attivo in ogni campo supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なアプリはありません。Cotabbyはサポートされるすべての入力欄で有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화된 앱이 없습니다. Cotabby는 지원되는 모든 필드에서 활성화되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app está desativado. O Cotabby está ativo em todos os campos compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключённых приложений нет. Cotabby активен во всех поддерживаемых полях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir uygulama devre dışı değil. Cotabby desteklenen her alanda etkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未停用任何 App。Cotabby 在所有支持的输入框中均处于启用状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有停用任何 App。Cotabby 在所有支援的輸入欄位中都處於啟用狀態。"
          }
        }
      }
    },
    "No downloaded models were found, so there is nothing to fall back to. Switch the engine to Open Source to download one.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+AppleIntelligence.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على نماذج تم تنزيلها، لذا لا يوجد ما يمكن الرجوع إليه. بدّل المحرك إلى Open Source لتنزيل نموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine heruntergeladenen Modelle gefunden; es gibt kein Fallback. Wechsle zur Open-Source-Engine, um eines herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron modelos descargados, así que no hay nada a lo que recurrir. Cambia el motor a Open Source para descargar uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle téléchargé n’a été trouvé ; aucun modèle ne peut donc servir de solution de secours. Passez au moteur Open Source pour en télécharger un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डाउनलोड किया गया मॉडल नहीं मिला, इसलिए फ़ॉलबैक के लिए कुछ नहीं है। एक डाउनलोड करने के लिए इंजन को Open Source पर बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan model yang diunduh, jadi tidak ada yang dapat digunakan sebagai fallback. Ganti engine ke Open Source untuk mengunduhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono stati trovati modelli scaricati, quindi non c'è alcun modello alternativo da usare. Passa al motore Open Source per scaricarne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォールバックするダウンロード済みモデルがないため、切り替えられません。エンジンをOpen Sourceに切り替えてダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델이 없어 대체할 수 없습니다. 엔진을 Open Source로 전환하여 하나를 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo baixado foi encontrado, então não há modelo alternativo disponível. Mude o mecanismo para Open Source para baixar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженных моделей не найдено, поэтому использовать резервную нечего. Переключите движок на Open Source, чтобы загрузить модель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek olarak kullanılacak indirilmiş model bulunamadı. Model indirmek için motoru Open Source'a geçirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到已下载的模型，因此没有可回退的模型。请将引擎切换为 Open Source 以下载一个模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到已下載的模型，因此沒有可用的備援模型。請將引擎切換至開放原始碼以下載模型。"
          }
        }
      }
    },
