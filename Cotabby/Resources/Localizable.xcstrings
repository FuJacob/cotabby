    "Show a running count of words you've accepted next to the menu bar icon.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار عدد مستمر للكلمات التي قبلتها بجوار أيقونة شريط القوائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine laufende Anzahl übernommener Wörter neben dem Menüleistensymbol anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra junto al icono de la barra de menús un recuento actualizado de las palabras que has aceptado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher à côté de l’icône de la barre des menus le nombre de mots que vous avez acceptés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेनू बार आइकन के पास आपके स्वीकार किए गए शब्दों की लगातार गिनती दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan jumlah berjalan kata yang telah Anda terima di samping ikon bar menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un conteggio aggiornato delle parole accettate accanto all'icona nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挿入した単語数をメニューバーアイコンの横に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘 옆에 수락한 단어의 누적 수를 표시합니다."
          }
        },
        "pt-BR": {
