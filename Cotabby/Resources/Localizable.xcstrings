    "Uses the global shortcut (%@). Click Change to set a custom key for %@.": {
      "comment": "Used in: UI/Settings/Panes/AppsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الاختصار العام (%@). انقر على تغيير لتعيين مفتاح مخصص لـ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den globalen Kurzbefehl (%@). Klicke auf „Ändern“, um eine benutzerdefinierte Taste für %@ festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Uses the global shortcut (%1$@). Click Change to set a custom key for %2$@."
          }
        },
        "es": {
          "stringUnit": {
