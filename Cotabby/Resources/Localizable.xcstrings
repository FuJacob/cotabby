    "Swift wrapper around llama.cpp that exposes the inference API Cotabby links against.": {
      "comment": "Used in: UI/Settings/Panes/About/AcknowledgementsView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غلاف Swift حول llama.cpp يوفّر واجهة الاستدلال التي يرتبط بها Cotabby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift-Wrapper für llama.cpp, der die Inferenz-API bereitstellt, die Cotabby einbindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoltorio Swift de llama.cpp que expone la API de inferencia con la que enlaza Cotabby."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enveloppe Swift autour de llama.cpp qui expose l’API d’inférence utilisée par Cotabby."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp के चारों ओर Swift रैपर जो Cotabby द्वारा लिंक किए गए अनुमान API को उपलब्ध कराता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
