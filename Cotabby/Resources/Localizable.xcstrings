    "This removes every recorded and imported entry and its encryption key. It can't be undone.": {
      "comment": "Used in: UI/Settings/Panes/TypingHistorySectionView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف كل الإدخالات المسجّلة والمستوردة ومفتاح التشفير الخاص بسجل الكتابة. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt jeden aufgezeichneten und importierten Eintrag sowie dessen Verschlüsselungsschlüssel. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las entradas registradas e importadas y su clave de cifrado. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime toutes les entrées enregistrées et importées ainsi que leur clé de chiffrement. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हर रिकॉर्ड की गई और इंपोर्ट की गई प्रविष्टि तथा उसकी एन्क्रिप्शन कुंजी हट जाएगी। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus semua entri yang direkam dan diimpor beserta kunci enkripsinya. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimosse tutte le voci registrate e importate, insieme alla relativa chiave di cifratura. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録および読み込んだエントリとその暗号化キーをすべて削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 및 가져온 모든 항목과 암호화 키를 제거합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove todas as entradas registradas e importadas e sua chave de criptografia. Não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все записанные и импортированные записи и ключ шифрования. Отменить это нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kaydedilmiş ve içe aktarılmış her girdiyi ve şifreleme anahtarını kaldırır. Geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除所有已记录和导入的条目及其加密密钥。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除所有已記錄及匯入的項目與其加密金鑰。此操作無法復原。"
          }
        }
      }
    },
    "This server is outside your Mac. Typed text and any enabled context will leave your device.": {
      "comment": "Used in: Models/Runtime/OpenAICompatibleEndpointModels.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الخادم خارج جهاز Mac لديك. سيغادر النص المكتوب وأي سياق مفعّل جهازك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server befindet sich außerhalb deines Macs. Getippter Text und jeder aktivierte Kontext verlassen dein Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está fuera de tu Mac. El texto escrito y cualquier contexto activado saldrán de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur se trouve en dehors de votre Mac. Le texte saisi et tout contexte activé quitteront votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर आपके Mac के बाहर है। टाइप किया गया टेक्स्ट और कोई भी सक्षम संदर्भ आपके डिवाइस से बाहर जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ini berada di luar Mac Anda. Teks yang diketik dan konteks yang diaktifkan akan meninggalkan perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server si trova fuori dal Mac. Il testo digitato e qualsiasi contesto abilitato lasceranno il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはMacの外部にあります。入力したテキストと有効にしたコンテキストがデバイス外に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 Mac 외부에 있습니다. 입력한 텍스트와 활성화된 모든 컨텍스트가 기기 밖으로 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está fora do Mac. O texto digitado e qualquer contexto ativado sairão do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер находится за пределами вашего Mac. Набираемый текст и любой включённый контекст покинут устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu Mac'inizin dışındadır. Yazdığınız metin ve etkinleştirilmiş bağlam aygıtınızdan çıkar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器不在你的 Mac 上。输入文本和任何已启用的上下文都会离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器位於你的 Mac 外部。輸入文字與任何啟用的內容都會離開你的裝置。"
          }
        }
      }
    },
