    "The color of the inline suggestion. Automatic adapts to light and dark.": {
      "comment": "Used in: UI/Settings/Panes/AppearancePaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون الاقتراح المضمّن. يكيّف الوضع التلقائي اللون مع النمط الفاتح والداكن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe des Inline-Vorschlags. Automatisch passt sich an hell und dunkel an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de la sugerencia en línea. Automático se adapta a los modos claro y oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur de la suggestion en ligne. Le mode Automatique s’adapte aux apparences claire et sombre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनलाइन सुझाव का रंग। Automatic हल्के और गहरे रूप-रंग के अनुसार बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna saran sebaris. Otomatis menyesuaikan dengan mode terang dan gelap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore del suggerimento in linea. Automatico si adatta ai temi chiaro e scuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インライン候補の色。自動ではライトとダークに合わせて調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인라인 제안의 색상입니다. 자동은 밝은 모드와 어두운 모드에 맞게 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor da sugestão inline. Automático se adapta aos modos claro e escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет встроенной подсказки. «Автоматически» адаптируется к светлому и тёмному режимам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır içi önerinin rengi. Otomatik, açık ve koyu görünüme uyum sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行内建议的颜色。“自动”会适应浅色和深色模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內嵌建議的顏色。「自動」會適應淺色與深色外觀。"
          }
        }
      }
    },
    "The downloaded model used when Apple Intelligence can't handle the language. It is also your Open Source engine's model.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+AppleIntelligence.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج الذي تم تنزيله ويُستخدم عندما لا يستطيع Apple Intelligence التعامل مع اللغة. وهو أيضًا نموذج محرك Open Source لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladenes Modell, das verwendet wird, wenn Apple Intelligence die Sprache nicht verarbeiten kann. Es ist auch das Modell deiner Open-Source-Engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo descargado que se usa cuando Apple Intelligence no puede gestionar el idioma. También es el modelo del motor Open Source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle téléchargé utilisé quand Apple Intelligence ne peut pas gérer la langue. C’est aussi le modèle de votre moteur Open Source."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence द्वारा भाषा संभाल न पाने पर उपयोग किया जाने वाला डाउनलोड किया गया मॉडल। यही आपके Open Source इंजन का मॉडल भी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yang diunduh dan digunakan saat Apple Intelligence tidak dapat menangani bahasa tersebut. Model ini juga merupakan model engine Open Source Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scaricato usato quando Apple Intelligence non può gestire la lingua. È anche il modello del motore Open Source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceが言語に対応できない場合に使うダウンロード済みモデル。Open Sourceエンジンのモデルでもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 언어를 처리할 수 없을 때 사용하는 다운로드된 모델입니다. Open Source 엔진의 모델이기도 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo baixado usado quando o Apple Intelligence não consegue lidar com o idioma. Ele também é o modelo do seu mecanismo Open Source."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженная модель, используемая, когда Apple Intelligence не справляется с языком. Это также модель вашего движка Open Source."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dili işleyemediğinde kullanılan indirilen model. Aynı zamanda Open Source motorunuzun modelidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Apple Intelligence 不支持当前语言时使用的已下载模型。它也是 Open Source 引擎所用的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 無法處理該語言時使用的下載模型，也是開放原始碼引擎所使用的模型。"
          }
        }
      }
    },
    "The endpoint API key could not be updated (Keychain status %d).": {
