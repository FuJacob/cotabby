          }
        }
      }
    },
    "Remove Cotabby from Applications. To fully clean up model data, delete %@.": {
      "comment": "Used in: UI/Settings/Panes/About/AboutPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزِل Cotabby من مجلد التطبيقات. ولحذف بيانات النماذج بالكامل، احذف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby aus dem Ordner „Programme“ entfernen. Um Modelldaten vollständig zu bereinigen, lösche %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina Cotabby de Aplicaciones. Para limpiar por completo los datos de modelos, elimina %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer Cotabby des Applications. Pour effacer complètement les données des modèles, supprimez %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications से Cotabby हटाएँ। मॉडल डेटा पूरी तरह साफ़ करने के लिए %@ हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus Cotabby dari Aplikasi. Untuk membersihkan data model sepenuhnya, hapus %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi Cotabby dalle Applicazioni. Per eliminare completamente i dati dei modelli, elimina %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyをアプリケーションから削除します。モデルデータを完全に消去するには%@を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램에서 Cotabby를 제거합니다. 모델 데이터를 완전히 정리하려면 %@을(를) 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o Cotabby de Aplicativos. Para limpar completamente os dados dos modelos, apague %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить Cotabby из приложений. Чтобы полностью очистить данные моделей, удалите %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby'yi Uygulamalar'dan kaldırın. Model verilerini tamamen temizlemek için %@ öğesini silin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“应用程序”中移除 Cotabby。要彻底清理模型数据，请删除 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「應用程式」移除 Cotabby。若要完整清理模型資料，請刪除 %@。"
          }
        }
      }
    },
