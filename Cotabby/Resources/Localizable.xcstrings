    "Import cancelled because typing history was deleted.": {
      "comment": "Used in: Services/History/TypingHistoryStore.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي الاستيراد لأن سجل الكتابة حُذف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import abgebrochen, weil der Schreibverlauf gelöscht wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación se canceló porque se eliminó el historial de escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importation annulée car l’historique de saisie a été supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइपिंग इतिहास हटाए जाने के कारण इंपोर्ट रद्द किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor dibatalkan karena riwayat ketikan telah dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione annullata perché la cronologia di digitazione è stata eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力履歴が削除されたため、読み込みをキャンセルしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 기록을 삭제했으므로 가져오기를 취소했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação foi cancelada porque o histórico de digitação foi apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт отменён, потому что история ввода удалена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma geçmişi silindiği için içe aktarma iptal edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于输入历史已删除，导入已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因打字記錄已刪除，匯入已取消。"
          }
        }
      }
    },
