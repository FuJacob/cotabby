    "Chat uses /v1/chat/completions (recommended). Text uses /v1/completions for base models that continue a raw prompt.": {
      "comment": "Used in: UI/Settings/Panes/Engine/EngineAndModelPaneView+Endpoint.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم المحادثة /v1/chat/completions (موصى به). ويستخدم النص /v1/completions للنماذج الأساسية التي تتابع مطالبة خام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat verwendet /v1/chat/completions (empfohlen). Text verwendet /v1/completions für Basismodelle, die einen Roh-Prompt fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat usa /v1/chat/completions (recomendado). Texto usa /v1/completions para modelos base que continúan una indicación sin formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Chat » utilise /v1/chat/completions (recommandé). « Texte » utilise /v1/completions pour les modèles de base qui poursuivent un texte d’entrée brut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat इस मॉडल के लिए /v1/chat/completions का उपयोग करता है (अनुशंसित)। Text उन बेस मॉडल के लिए /v1/completions का उपयोग करता है जो रॉ प्रॉम्प्ट जारी रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat menggunakan /v1/chat/completions (disarankan). Text menggunakan /v1/completions untuk model dasar yang melanjutkan prompt mentah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Chat usa /v1/chat/completions (consigliato). La modalità Testo usa /v1/completions per i modelli base che continuano un prompt grezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットは /v1/chat/completions（推奨）を使用します。テキストは、生のプロンプトを続けるベースモデル向けに /v1/completions を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅은 /v1/chat/completions를 사용합니다(권장). 텍스트는 원시 프롬프트를 이어가는 base 모델에 /v1/completions를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato Chat Completions usa /v1/chat/completions (recomendado). O formato Text Completions usa /v1/completions para modelos base que continuam um prompt bruto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат использует /v1/chat/completions (рекомендуется). Текст использует /v1/completions для базовых моделей, продолжающих необработанный запрос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet, /v1/chat/completions uç noktasını kullanır (önerilir). Metin, ham istemi sürdüren temel modeller için /v1/completions uç noktasını kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天使用 /v1/chat/completions（推荐）。文本使用 /v1/completions，适用于续写原始提示的基础模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat 使用 /v1/chat/completions（建議）。Text 使用 /v1/completions，適用於接續原始提示的基礎模型。"
          }
        }
      }
    },
