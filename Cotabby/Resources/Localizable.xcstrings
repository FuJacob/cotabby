    "Every Cotabby setting returns to its original default. This can't be undone.": {
      "comment": "Used in: UI/Settings/Panes/GeneralPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود كل إعدادات Cotabby إلى قيمتها الافتراضية الأصلية. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Cotabby-Einstellung wird auf ihren ursprünglichen Standard zurückgesetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes de Cotabby volverán a sus valores predeterminados originales. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages de Cotabby reviennent à leurs valeurs par défaut d’origine. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby की हर सेटिंग अपने मूल डिफ़ॉल्ट पर लौट जाएगी। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengaturan Cotabby kembali ke nilai bawaan semula. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni impostazione di Cotabby torna al suo valore predefinito originale. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyのすべての設定が元のデフォルトに戻ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Cotabby 설정이 원래 기본값으로 돌아갑니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ajustes do Cotabby voltarão ao padrão original. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки Cotabby вернутся к исходным значениям по умолчанию. Это нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Cotabby ayarı ilk varsayılanına döner. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby 的所有设置都将恢复为原始默认值。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 Cotabby 設定都會還原為原始預設值。此操作無法復原。"
          }
        }
      }
    },
    "Every macro Cotabby can resolve from a `/` query.": {
      "comment": "Used in: UI/InlineFeatures/MacroReferenceSheet.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وحدات الماكرو التي يستطيع Cotabby تنفيذها من استعلام يبدأ بـ `/`."
          }
        },
        "de": {
          "stringUnit": {
