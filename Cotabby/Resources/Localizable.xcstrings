          }
        }
      }
    },
    "Downloaded file's checksum (%@…) doesn't match the expected (%@…). The file may be corrupt.": {
      "comment": "Used in: Services/ModelManagement/ModelFileValidator.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطابق مجموع التحقق للملف الذي تم تنزيله (%@…) المتوقع (%@…). قد يكون الملف تالفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfsumme der heruntergeladenen Datei (%@…) stimmt nicht mit der erwarteten (%@…) überein. Die Datei ist möglicherweise beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Downloaded file's checksum (%1$@…) doesn't match the expected (%2$@…). The file may be corrupt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma de comprobación del archivo descargado (%@…) no coincide con la esperada (%@…). El archivo podría estar dañado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme de contrôle du fichier téléchargé (%@…) ne correspond pas à celle attendue (%@…). Le fichier est peut-être corrompu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड की गई फ़ाइल का चेकसम (%@…) अपेक्षित (%@…) से मेल नहीं खाता। फ़ाइल खराब हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Checksum file yang diunduh (%@…) tidak cocok dengan yang diharapkan (%@…). File mungkin rusak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checksum del file scaricato (%@…) non corrisponde a quello previsto (%@…). Il file potrebbe essere danneggiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルのチェックサム（%@…）が想定値（%@…）と一致しません。ファイルが壊れている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 파일의 체크섬(%@…)이 예상값(%@…)과 일치하지 않습니다. 파일이 손상되었을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A soma de verificação do arquivo baixado (%@…) não corresponde à esperada (%@…). O arquivo pode estar corrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма загруженного файла (%@…) не совпадает с ожидаемой (%@…). Файл может быть повреждён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosyanın sağlama toplamı (%@…) beklenenle (%@…) eşleşmiyor. Dosya bozuk olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件的校验和（%@…）与预期值（%@…）不匹配。文件可能已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載檔案的檢查碼（%@…）與預期值（%@…）不符。檔案可能已損毀。"
          }
        }
      }
    },
