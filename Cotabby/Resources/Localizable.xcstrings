            "value": "Jeda pelengkapan otomatis saat kata tampak salah eja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa i completamenti mentre una parola sembra contenere un errore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語にスペルミスがある間は補完を一時停止します。"
