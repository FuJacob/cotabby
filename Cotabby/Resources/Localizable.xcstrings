    "Longer suggestions and higher quality on harder prompts.": {
      "comment": "Used in: Models/Onboarding/OnboardingTemplate.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراحات أطول وجودة أعلى للمطالبات الأصعب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Längere Vorschläge und höhere Qualität bei schwierigeren Eingaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencias más largas y de mayor calidad para indicaciones más difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions plus longues et de meilleure qualité pour les demandes complexes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कठिन प्रॉम्प्ट पर लंबे सुझाव और बेहतर गुणवत्ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saran lebih panjang dan kualitas lebih tinggi untuk prompt yang sulit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimenti più lunghi e qualità superiore per prompt più difficili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "難しいプロンプトでは、より長い候補と高い品質。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 어려운 프롬프트에 더 긴 제안과 높은 품질."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestões mais longas e de maior qualidade para prompts mais difíceis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более длинные подсказки и более высокое качество для сложных запросов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha uzun öneriler ve zor istemlerde daha yüksek kalite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更长的建议，以及在较难提示下更高的质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面對較困難的提示時提供較長建議與更高品質。"
          }
        }
      }
    },
