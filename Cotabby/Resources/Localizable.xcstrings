    "Drag %@ to the list above to allow %@": {
      "comment": "Used in: Services/Permission/Guidance/PermissionOverlayWindowController.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب %@ إلى القائمة أعلاه للسماح لـ %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe %@ in die obige Liste, um %@ zu erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Drag %1$@ to the list above to allow %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra %@ a la lista de arriba para permitir %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser %@ vers la liste ci-dessus pour autoriser %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को ऊपर की सूची में खींचकर %@ की अनुमति दें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret %@ ke daftar di atas untuk mengizinkan %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina %@ nell'elenco qui sopra per consentire %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を上のリストにドラッグして%@を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 위 목록으로 드래그하여 %@ 허용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste %@ para a lista acima para permitir %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите %@ в список выше, чтобы разрешить %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öğesini yukarıdaki listeye sürükleyerek %@ öğesine izin verin"
