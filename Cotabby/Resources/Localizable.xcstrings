    "Homebrew could not install aria2. Cotabby will use its standard downloader.": {
      "comment": "Used in: Services/ModelManagement/Aria2Provisioner.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Homebrew تثبيت aria2. سيستخدم Cotabby أداة التنزيل القياسية لديه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte aria2 nicht installieren. Cotabby verwendet den Standard-Downloader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no pudo instalar aria2. Cotabby usará su descargador estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’a pas pu installer aria2. Cotabby utilisera son téléchargeur standard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aria2 इंस्टॉल नहीं कर सका। Cotabby अपना मानक डाउनलोडर उपयोग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew tidak dapat memasang aria2. Cotabby akan menggunakan pengunduh standarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non ha potuto installare aria2. Cotabby userà il suo downloader standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewでaria2をインストールできませんでした。Cotabbyは標準のダウンローダーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew에서 aria2를 설치하지 못했습니다. Cotabby는 표준 다운로더를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não conseguiu instalar o aria2. O Cotabby usará seu downloader padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew не удалось установить aria2. Cotabby использует стандартный загрузчик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aria2'yi yükleyemedi. Cotabby standart indiricisini kullanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 无法安装 aria2。Cotabby 将使用标准下载器。"
          }
        },
