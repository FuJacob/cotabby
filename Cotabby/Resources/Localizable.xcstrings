          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence a renvoyé une réponse que Cotabby n’a pas pu décoder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ने ऐसा जवाब दिया जिसे Cotabby डिकोड नहीं कर सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence mengembalikan respons yang tidak dapat didekode Cotabby."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ha restituito una risposta che Cotabby non ha potuto decodificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceが返した応答をCotabbyは解析できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 Cotabby가 해석할 수 없는 응답을 반환했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence retornou uma resposta que o Cotabby não conseguiu decodificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вернула ответ, который Cotabby не смог декодировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, Cotabby'nin çözemediği bir yanıt döndürdü."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 返回了 Cotabby 无法解码的响应。"
          }
