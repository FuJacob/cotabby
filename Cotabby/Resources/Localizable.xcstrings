          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 윈도우에서 가져오는 선택적 시각적 컨텍스트."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto visual opcional da janela em foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательный визуальный контекст из окна в фокусе."
