    "No per-app shortcuts. Cotabby uses the global accept key everywhere.": {
      "comment": "Used in: UI/Settings/Panes/AppsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد اختصارات لكل تطبيق. يستخدم Cotabby مفتاح القبول العام في كل مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App-spezifischen Kurzbefehle. Cotabby verwendet überall die globale Übernahmetaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay atajos por app. Cotabby usa la tecla de aceptación global en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
