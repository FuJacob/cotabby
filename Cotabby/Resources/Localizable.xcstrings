          "stringUnit": {
            "state": "translated",
            "value": "Se Cotabby può raggiungere il server ed elencarne i modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyがサーバーに接続してモデル一覧を取得できるかどうか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby가 서버에 연결하여 모델을 나열할 수 있는지 여부."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
