    "Press %@ twice quickly to insert the whole suggestion. A single press still inserts the next %@.": {
      "comment": "Used in: UI/Settings/Panes/ShortcutsPaneView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط %@ مرتين بسرعة لإدراج الاقتراح بالكامل. تؤدي الضغطة الواحدة إلى إدراج %@ التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zweimal schnell drücken, um den gesamten Vorschlag einzufügen. Ein einzelner Druck fügt weiterhin das nächste %@ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Press %1$@ twice quickly to insert the whole suggestion. A single press still inserts the next %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ dos veces rápido para insertar toda la sugerencia. Una sola pulsación sigue insertando el siguiente %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez rapidement deux fois sur %@ pour insérer toute la suggestion. Un seul appui insère toujours le %@ suivant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा सुझाव डालने के लिए %@ को तेज़ी से दो बार दबाएँ। एक बार दबाने पर भी अगला %@ डाला जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan %@ dua kali dengan cepat untuk menyisipkan seluruh saran. Satu tekanan tetap menyisipkan %@ berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ rapidamente due volte per inserire l'intero suggerimento. Una singola pressione inserisce comunque il %@ successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補全体を挿入するには%@をすばやく2回押します。1回押すと次の%@を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 빠르게 두 번 눌러 전체 제안을 삽입합니다. 한 번 누르면 다음 %@을 삽입합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ duas vezes rapidamente para inserir a sugestão inteira. Um único toque ainda insere o próximo %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ дважды быстро, чтобы вставить всю подсказку. Одно нажатие по-прежнему вставляет следующий %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tuşuna hızlıca iki kez basarak önerinin tamamını ekleyin. Tek basışla sonraki %@ eklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速按 %@ 两次以插入整条建议。按一次仍会插入下一个 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速按 %@ 兩次即可插入完整建議。單次按下仍會插入下一個 %@。"
          }
        }
      }
    },
