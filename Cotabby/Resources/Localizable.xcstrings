    "Add at least one language so Cotabby knows what to write in.": {
      "comment": "Used in: UI/Onboarding/Welcome/WelcomeView.swift",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف لغة واحدة على الأقل كي يعرف Cotabby ما الذي سيكتبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mindestens eine Sprache hinzu, damit Cotabby weiß, in welcher Sprache es schreiben soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos un idioma para que Cotabby sepa en qué escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins une langue pour que Cotabby sache dans quelle langue écrire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक भाषा जोड़ें ताकि Cotabby जान सके कि क्या लिखना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan setidaknya satu bahasa agar Cotabby tahu bahasa yang digunakan untuk menulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi almeno una lingua, così Cotabby sa in quale lingua scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabbyが文章を書く言語を少なくとも1つ追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotabby가 작성할 내용을 알 수 있도록 언어를 하나 이상 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pelo menos um idioma para o Cotabby saber em que idioma escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы один язык, чтобы Cotabby знал, на каком языке писать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
