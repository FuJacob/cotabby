# Xcode
# Finder/iCloud numbered copies are not generated build inputs. Keep only Cotabby.xcodeproj.
/CoHamster*.xcodeproj/
/Cotabby [0-9]*.xcodeproj/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# Local signing (per-developer Apple team id; written by scripts/dev-setup.sh)
Signing.local.xcconfig

# Swift Package Manager
.build/
.swiftpm/
**/xcshareddata/swiftpm/Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python virtual environments
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# Personal notes
launch.txt
posts.txt
.writing/

# Claude Code
.claude/worktrees/
.claude/scheduled_tasks.lock

# Large model files — keep out of git
*.gguf
*.bin
.rocketride/

.agents
.internal

# Fastlane/Bundler local state; never commit signing material or environment secrets.
.bundle/
vendor/bundle/
fastlane/report.xml
fastlane/.env*
!fastlane/.env.example
*.p12
*.p8
*.keychain-db
